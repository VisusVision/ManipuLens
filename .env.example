# Yerel Ollama sunucusu (src/agents.rs)
OLLAMA_URL=http://127.0.0.1:11434

# OTP / dogrulama maili icin SMTP ayarlari (src/main.rs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# GELISTIRME: e-posta dogrulamasini tamamen kapatir (src/main.rs mail_disabled).
# 1/true iken kayit aninda dogrulanmis sayilir, /v1/verify ve /v1/resend devre
# disidir, sifre sifirlama 6 haneli kod istemez.
# UYARI: bu mod acikken /v1/reset, e-postayi bilen herkesin sifreyi
# degistirmesine izin verir. Yalnizca yerel gelistirmede kullanin.
AUTH_MAIL_DISABLED=0
