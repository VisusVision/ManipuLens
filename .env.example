# Yerel Ollama sunucusu (src/agents.rs)
OLLAMA_URL=http://127.0.0.1:11434

# OTP / dogrulama maili icin SMTP ayarlari (src/main.rs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Kayit ve giriste e-posta dogrulama kodunu atlar. Varsayilan 1'dir.
# Sifre sifirlama kodu bu ayardan etkilenmez.
AUTH_EMAIL_VERIFICATION_DISABLED=1

# GELISTIRME: tum mail kodlarini kapatir. Varsayilan 0'dir.
# UYARI: 1 iken /v1/reset, e-postayi bilen herkesin sifreyi degistirmesine
# izin verir. Yalnizca yerel gelistirmede kullanin.
AUTH_MAIL_DISABLED=0
