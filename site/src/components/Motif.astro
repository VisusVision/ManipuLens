    <path d="M8 42h48" class="k"/>
    <path d="M8 50h34" class="v"/>
    <circle cx="52" cy="50" r="3" class="vd"/>`,

  // Çerçeveleme: kutu, içeriğin bir kısmını kesiyor.
  cerceveleme: `
    <path d="M10 10h16M10 10v16M54 10H38M54 10v16M10 54h16M10 54V38M54 54H38M54 54V38" class="k"/>
    <path d="M22 40l8-12 6 8 6-6" class="v"/>
    <circle cx="42" cy="24" r="3" class="vd"/>
    <path d="M2 32h6M56 32h6" class="i"/>`,

  // Güven puanı: 0-1 arası gösterge.
  'guven-puani': `
    <path d="M8 44a24 24 0 0 1 48 0" class="k"/>
    <path d="M32 44l14-12" class="v"/>
    <circle cx="32" cy="44" r="3.5" class="k"/>
    <path d="M10 50h8M46 50h8" class="i"/>
    <circle cx="16" cy="34" r="2" class="vd"/>
    <circle cx="48" cy="34" r="2" class="vd"/>`,

  // --- Sistem motifleri ---

  // Lens: projenin ana motifi.
  lens: `
    <circle cx="28" cy="28" r="18" class="k"/>
    <circle cx="28" cy="28" r="9" class="v"/>
    <path d="M41 41l14 14" class="k"/>
    <path d="M20 22c3-4 9-5 13-2" class="i"/>`,

  // Tarama çizgisi: analiz anı.
  tarama: `
    <rect x="8" y="12" width="48" height="40" class="k"/>
    <path d="M8 30h48" class="v"/>
    <path d="M16 20h24M16 40h16M40 40h8" class="i"/>
    <circle cx="52" cy="30" r="2.5" class="vd"/>`,

  // Seçili metin bloğu: her şeyin başladığı yer.
  secim: `
    <rect x="8" y="14" width="48" height="36" class="k"/>
    <rect x="14" y="22" width="28" height="6" class="v"/>
    <path d="M14 34h34M14 42h22" class="i"/>
    <path d="M44 28l6 10-4 1 3 6-3 1-3-6-3 3z" class="k"/>`,

  // Prizma: altı ajan, tek metin.
  prizma: `
    <path d="M32 10L10 48h44z" class="k"/>
    <path d="M4 30h16" class="v"/>
    <path d="M40 24l18-6M42 30l18 0M44 36l18 6" class="v"/>
    <circle cx="32" cy="36" r="2.5" class="vd"/>`,

  // Kasa: veri yerelde kalıyor.
  kasa: `
    <rect x="8" y="12" width="48" height="40" class="k"/>
    <circle cx="32" cy="32" r="11" class="k"/>
    <path d="M32 26v6l5 3" class="v"/>
    <path d="M32 21v-4M32 47v-4M43 32h4M21 32h-4" class="i"/>`,
};

const govde = M[ad] ?? M.lens;
const dekoratif = !alt;
---
<svg
  class="ml-motif"
  viewBox="0 0 64 64"
  width={boyut}
  height={boyut}
  fill="none"
  role={dekoratif ? 'presentation' : 'img'}
  aria-hidden={dekoratif ? 'true' : undefined}
  aria-label={alt}
  set:html={govde}
/>

<style>
  .ml-motif {
    display: block;
    flex: none;
    color: var(--ml-ink);
  }
  /* k = kontur (ana hat), v = vurgu (turkuaz), i = ikincil (soluk), vd = dolu nokta */
  .ml-motif :global(.k) {
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ml-motif :global(.v) {
    stroke: var(--ml-scan);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ml-motif :global(.i) {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.35;
  }
  .ml-motif :global(.vd) { fill: var(--ml-scan); }
  /* Dolu kullanilan sekiller (rect.v gibi) konturu degil zemini alsin. */
  .ml-motif :global(rect.v) { fill: var(--ml-scan-dim); stroke: var(--ml-scan); }
  .ml-motif :global(path.vd) { fill: var(--ml-scan-dim); stroke: none; }
</style>
