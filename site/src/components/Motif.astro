    <circle cx="38" cy="26" r="2" class="vd"/>`,

  // Davranışsal: geri sayan kronometre - düşünme süresi kısaltılıyor.
  'davranissal-manipulasyon': `
    <circle cx="32" cy="36" r="18" class="k"/>
    <path d="M26 10h12M32 10v8" class="k"/>
    <path d="M32 36V24" class="v"/>
    <path d="M32 36l9 6" class="v"/>
    <path d="M50 20l5-5M14 20l-5-5" class="i"/>`,

  // Algısal: aynı veri, iki çerçeve.
  'algisal-manipulasyon': `
    <rect x="6" y="20" width="24" height="24" class="k"/>
    <rect x="34" y="20" width="24" height="24" class="k"/>
    <path d="M6 32h24" class="v"/>
    <path d="M34 38h24" class="v"/>
    <path d="M12 52h12M40 52h12" class="i"/>
    <circle cx="18" cy="14" r="2.5" class="vd"/>
    <circle cx="46" cy="14" r="2.5" class="vd"/>`,

  // Sosyal: kalabalık kanıt gibi gösteriliyor.
  'sosyal-manipulasyon': `
    <circle cx="16" cy="24" r="6" class="k"/>
    <circle cx="32" cy="20" r="6" class="k"/>
    <circle cx="48" cy="24" r="6" class="k"/>
    <path d="M6 46c0-7 5-11 10-11s10 4 10 11" class="k"/>
    <path d="M22 44c0-8 5-13 10-13s10 5 10 13" class="k"/>
    <path d="M38 46c0-7 5-11 10-11s10 4 10 11" class="k"/>
    <path d="M32 52v6" class="v"/>`,

  // Pazarlama: fiyat etiketinin arkasındaki maske.
  'pazarlama-manipulasyonu': `
    <path d="M34 8H14v20l24 24 18-18-22-26z" class="k"/>
    <circle cx="24" cy="18" r="3" class="v"/>
    <path d="M20 40c4-5 12-5 16 0-4 5-12 5-16 0z" class="vd"/>
    <path d="M40 34c4-4 10-4 14 0" class="i"/>`,

  // Aciliyet: kum saati + hız çizgileri.
  aciliyet: `
    <path d="M18 8h28M18 56h28" class="k"/>
    <path d="M20 8c0 12 12 18 12 24s-12 12-12 24" class="k"/>
    <path d="M44 8c0 12-12 18-12 24s12 12 12 24" class="k"/>
    <path d="M26 48h12" class="v"/>
    <circle cx="32" cy="32" r="2.5" class="vd"/>
    <path d="M8 22h6M8 32h4M8 42h6" class="i"/>`,

  // Kıtlık: boş raf, tek kutu.
  kitlik: `
    <path d="M6 44h52M6 24h52" class="k"/>
    <rect x="40" y="30" width="14" height="14" class="v"/>
    <rect x="10" y="10" width="12" height="14" class="i"/>
    <path d="M10 32h6M22 32h6M10 38h10" class="i"/>
    <circle cx="47" cy="37" r="2.5" class="vd"/>`,

  // Sosyal kanıt: yıldızlar ve rakam.
