---
/**
 * ManipuLens motif seti - satir ici SVG.
 *
 * Neden PNG degil: harici dosya = harici istek. Ayrica SVG koyu temada
 * `currentColor` sayesinde kendiliginden dogru renge donuyor, olceklendiginde
 * bozulmuyor ve toplam agirligi bir PNG'den kucuk.
 *
 * Gorsel dil: duz 2B editoryal, kalin kontur, tek vurgu rengi (turkuaz tarama
 * isigi), halftone nokta dokusu. Referans sitenin limon karakteri KOPYALANMAZ -
 * ManipuLens'in kendi motifi lens, tarama cizgisi ve kukla ipi uzerine kurulu.
 */
interface Props {
  ad: string;
  /** Ekran okuyucu icin; bos birakilirsa gorsel dekoratif sayilir. */
  alt?: string;
  boyut?: number;
}
const { ad, alt, boyut = 64 } = Astro.props;

const M: Record<string, string> = {
  // --- Manipülasyon kümesi (12) ---

  // Kukla ipi: yönlendirilen karar.
