---
/**
 * Sade / teknik anlatim anahtari.
 * Secim localStorage'da tutulur, sayfa yeniden yuklenmeden uygulanir.
 * Baslangic degeri <head> icindeki inline script tarafindan yazilir (FOUC yok).
 */
---
<div class="ml-toggle" role="group" aria-label="Anlatim seviyesi">
  <button type="button" data-mode="sade" aria-label="Sade anlatım" aria-pressed="true">
    Sade<span class="ml-toggle__wide"> anlatım</span>
  </button>
  <button type="button" data-mode="teknik" aria-label="Teknik ayrıntı" aria-pressed="false">
    Teknik<span class="ml-toggle__wide"> ayrıntı</span>
  </button>
</div>

<style>
  .ml-toggle {
    display: inline-flex;
    border: var(--ml-border);
    border-radius: var(--ml-radius);
    overflow: hidden;
    background: var(--ml-paper-warm);
  }
  .ml-toggle button {
    font: inherit;
    font-size: var(--ml-step--1);
    padding: 0.45rem 0.9rem;
    border: 0;
    background: transparent;
    color: var(--ml-ink-muted);
    cursor: pointer;
    min-height: 2.75rem;
  }
  .ml-toggle button + button { border-left: var(--ml-border); }
  .ml-toggle button[aria-pressed='true'] {
    background: var(--ml-navy);
    color: #f5f7fb;
    box-shadow: inset 0 -3px 0 var(--ml-scan);
  }
  @media (max-width: 48rem) {
    .ml-toggle button { padding-inline: 0.65rem; }
    .ml-toggle__wide { display: none; }
  }
</style>

<script>
  const KEY = 'manipulens:mode';
  const AZ_HAREKET = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Okunan yer ekranda sabit kalsin: ust kisimda duran, moddan etkilenmeyen
   *  bir baslik secilir; blok gidip gelince fark kadar scroll telafi edilir. */
  function capaAl() {
    const adaylar = document.querySelectorAll<HTMLElement>(
      '#icerik h2, #icerik h3, #icerik .ml-section, #icerik p',
    );
    let en: HTMLElement | null = null;
    let enUst = -Infinity;
    adaylar.forEach((el) => {
      if (el.closest('.ml-technical, .ml-simple-only')) return;
      const t = el.getBoundingClientRect().top;
      if (t <= 120 && t > enUst) { enUst = t; en = el; }
    });
    return en ? { el: en as HTMLElement, top: enUst } : null;
  }

  function capaGeriKoy(capa: { el: HTMLElement; top: number } | null) {
    if (!capa) return;
    const simdi = capa.el.getBoundingClientRect().top;
    const fark = simdi - capa.top;
    // scroll-behavior: smooth acik; telafi animasyona girerse yer yine kayar.
    if (Math.abs(fark) > 1) {
      window.scrollTo({ top: window.scrollY + fark, behavior: 'instant' as ScrollBehavior });
    }
  }

  function toast(): HTMLElement {
    let t = document.querySelector<HTMLElement>('.ml-mode-toast');
    if (!t) {
      t = document.createElement('div');
      t.className = 'ml-mode-toast';
      t.setAttribute('role', 'status');
      t.setAttribute('aria-live', 'polite');
      document.body.appendChild(t);
    }
    return t;
  }

  let toastZaman = 0;
  function toastGoster(mode: string, sayi: number) {
    const t = toast();
    const etiket = sayi === 1 ? 'blok' : 'blok';
    t.innerHTML =
      mode === 'teknik'
        ? `<span class="ml-mode-toast__sayi">${sayi}</span> teknik ${etiket} açıldı — dosya adları, sabitler, kod alıntıları.`
        : sayi > 0
          ? `<span class="ml-mode-toast__sayi">${sayi}</span> teknik ${etiket} gizlendi — sade anlatım açık.`
          : 'Sade anlatım açık.';
    t.setAttribute('data-acik', '');
    window.clearTimeout(toastZaman);
    toastZaman = window.setTimeout(() => t.removeAttribute('data-acik'), 3600);
  }

  function teknikBloklar(): HTMLElement[] {
    const ana = document.getElementById('icerik');
    return ana ? Array.from(ana.querySelectorAll<HTMLElement>('.ml-technical')) : [];
  }

  function butonlariIsaretle(mode: string) {
    document.querySelectorAll<HTMLButtonElement>('.ml-toggle button').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
    });
  }

  function modUygula(mode: string) {
    document.documentElement.dataset.mlMode = mode;
    butonlariIsaretle(mode);
    document.dispatchEvent(new CustomEvent('manipulens:mode-change', { detail: { mode } }));
  }

  /** Kullanici anahtara bastiginda: gorunur cikis/giris + capa + serit. */
  function modDegistir(mode: string) {
    if (document.documentElement.dataset.mlMode === mode) return;
    const bloklar = teknikBloklar();
    const sayi = bloklar.length;
    const capa = capaAl();

    const bitir = () => {
      modUygula(mode);
      capaGeriKoy(capa);
      if (mode === 'teknik' && !AZ_HAREKET()) {
        bloklar.forEach((b) => {
          b.classList.add('ml-mode-in');
          window.setTimeout(() => b.classList.remove('ml-mode-in'), 320);
        });
      }
      toastGoster(mode, sayi);
    };

    if (mode === 'sade' && sayi > 0 && !AZ_HAREKET()) {
      // Once solsun ki kullanici neyin gittigini gorsun, sonra yer birakmasin.
      bloklar.forEach((b) => b.classList.add('ml-mode-out'));
      window.setTimeout(() => {
        bitir();
        bloklar.forEach((b) => b.classList.remove('ml-mode-out'));
      }, 190);
    } else {
      bitir();
    }
  }

  function bind() {
    const mevcut = document.documentElement.dataset.mlMode ?? 'sade';
    butonlariIsaretle(mevcut);
    // Ilk yuklemede de haber ver: reveal taramasi ve serit sayimi buna bagli.
    document.dispatchEvent(new CustomEvent('manipulens:mode-change', { detail: { mode: mevcut } }));
    document.querySelectorAll<HTMLButtonElement>('.ml-toggle button').forEach((b) => {
      if (b.dataset.mlBagli) return;
      b.dataset.mlBagli = '1';
      b.addEventListener('click', () => {
        const mode = b.dataset.mode ?? 'sade';
        try { localStorage.setItem(KEY, mode); } catch { /* gizli sekme: yoksay */ }
        modDegistir(mode);
      });
    });
  }

  bind();
  document.addEventListener('astro:page-load', bind);
</script>
