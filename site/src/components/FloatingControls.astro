---
/**
 * Yüzen Akıllı Eylem Çubuğu:
 * - Simetrik Çift Yönlü Başlık Gezgini: [ ↑ Önceki ] [ %42 ] [ ↓ Sonraki ]
 * - Hızlı Sade / Teknik mod anahtarı
 * - Klavye kısayolları yardımcısı (?)
 * - Mobilde alt çekmece içindekiler (TOC) butonu
 */
---

<div class="ml-floating-controls" data-floating-controls aria-label="Hızlı sayfa kontrolleri">
  <!-- Mobil İçindekiler Butonu -->
  <button
    type="button"
    class="ml-floating-btn ml-floating-btn--toc"
    data-floating-toc-btn
    aria-label="Sayfa içindekiler"
    title="Sayfa içindekiler"
  >
    <span class="ml-floating-btn__icon">📑</span>
    <span class="ml-floating-btn__label">İçindekiler</span>
  </button>

  <!-- Masaüstü Klavye Kısayolları Butonu -->
  <button
    type="button"
    class="ml-floating-btn ml-floating-btn--kbd"
    data-floating-kbd-btn
    aria-label="Klavye kısayolları (?)"
    title="Klavye kısayolları (?)"
  >
    <span class="ml-floating-btn__icon">⌨️</span>
  </button>

  <!-- Hızlı Mod Değiştirici -->
  <button
    type="button"
    class="ml-floating-btn ml-floating-btn--mode"
    data-floating-mode-btn
    aria-label="Sade ve teknik mod arasında geçiş yap (T)"
    title="Sade / Teknik mod (T)"
  >
    <span class="ml-floating-btn__icon ml-floating-btn__icon--sade">👁️</span>
    <span class="ml-floating-btn__icon ml-floating-btn__icon--teknik">⚙️</span>
    <span class="ml-floating-btn__mode-text" data-floating-mode-text>Sade</span>
  </button>

  <!-- Simetrik Başlık Gezinme Grubu: [ ↑ Önceki ] [ %42 ] [ ↓ Sonraki ] -->
  <div class="ml-floating-nav-pill">
    <button
      type="button"
      class="ml-floating-nav-btn ml-floating-nav-btn--prev"
      data-floating-prev-btn
      aria-label="Önceki ana başlığa kaydır (K veya ↑)"
      title="Önceki ana başlık (K)"
    >
      <span class="ml-floating-nav-icon">↑</span>
      <span class="ml-floating-nav-label">Önceki</span>
    </button>

    <button
      type="button"
      class="ml-floating-nav-pct"
      data-floating-pct-btn
      aria-label="Okuma ilerlemesi - En yukarı çık (G)"
      title="Okuma İlerlemesi (Tıkla: En Başa Dön)"
    >
      <span data-floating-pct>0%</span>
    </button>

    <button
      type="button"
      class="ml-floating-nav-btn ml-floating-nav-btn--next"
      data-floating-next-btn
      aria-label="Sonraki ana başlığa kaydır (J veya ↓)"
      title="Sonraki ana başlık (J)"
    >
      <span class="ml-floating-nav-icon">↓</span>
      <span class="ml-floating-nav-label">Sonraki</span>
    </button>
  </div>
</div>

<!-- Mobil İçindekiler Çekmecesi -->
<div class="ml-toc-drawer" data-toc-drawer hidden aria-hidden="true">
  <div class="ml-toc-drawer__backdrop" data-toc-close></div>
  <div class="ml-toc-drawer__panel">
    <div class="ml-toc-drawer__header">
      <strong>📑 Bu Sayfanın Bölümleri</strong>
      <button type="button" class="ml-toc-drawer__close" data-toc-close aria-label="Kapat">✕</button>
    </div>
    <ol class="ml-toc-drawer__list" data-toc-list>
      <!-- Dinamik bölümler -->
    </ol>
  </div>
</div>

<!-- Klavye Kısayolları Modalı -->
<div class="ml-kbd-modal" data-kbd-modal hidden aria-hidden="true">
  <div class="ml-kbd-modal__backdrop" data-kbd-close></div>
  <div class="ml-kbd-modal__panel" role="dialog" aria-modal="true" aria-label="Klavye Kısayolları">
    <div class="ml-kbd-modal__header">
      <strong>⌨️ Klavye Gezinme Kısayolları</strong>
      <button type="button" class="ml-kbd-modal__close" data-kbd-close aria-label="Kapat">✕</button>
    </div>
    <div class="ml-kbd-modal__body">
      <div class="ml-kbd-row">
        <div class="ml-kbd-keys"><kbd>J</kbd> / <kbd>↓</kbd></div>
        <div class="ml-kbd-desc">Sonraki ana başlığa yumuşak kaydır</div>
      </div>
      <div class="ml-kbd-row">
        <div class="ml-kbd-keys"><kbd>K</kbd> / <kbd>↑</kbd></div>
        <div class="ml-kbd-desc">Önceki ana başlığa yumuşak kaydır</div>
      </div>
      <div class="ml-kbd-row">
        <div class="ml-kbd-keys"><kbd>T</kbd></div>
        <div class="ml-kbd-desc">Sade ve Teknik mod arasında geçiş yap</div>
      </div>
      <div class="ml-kbd-row">
        <div class="ml-kbd-keys"><kbd>Ctrl</kbd> + <kbd>K</kbd> veya <kbd>/</kbd></div>
        <div class="ml-kbd-desc">Spotlight hızlı arama penceresini aç</div>
      </div>
      <div class="ml-kbd-row">
        <div class="ml-kbd-keys"><kbd>G</kbd></div>
        <div class="ml-kbd-desc">Sayfanın en tepesine çık</div>
      </div>
      <div class="ml-kbd-row">
        <div class="ml-kbd-keys"><kbd>?</kbd></div>
        <div class="ml-kbd-desc">Bu kısayol kılavuzunu aç / kapat</div>
      </div>
      <div class="ml-kbd-row">
        <div class="ml-kbd-keys"><kbd>ESC</kbd></div>
        <div class="ml-kbd-desc">Açık pencereleri kapat</div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function mlYuzenKontrollerKur() {
    var bar = document.querySelector('[data-floating-controls]');
    var prevBtn = document.querySelector('[data-floating-prev-btn]');
    var nextBtn = document.querySelector('[data-floating-next-btn]');
    var pctBtn = document.querySelector('[data-floating-pct-btn]');
    var pctText = document.querySelector('[data-floating-pct]');
    var modeBtn = document.querySelector('[data-floating-mode-btn]');
    var modeText = document.querySelector('[data-floating-mode-text]');
    var tocBtn = document.querySelector('[data-floating-toc-btn]');
    var tocDrawer = document.querySelector('[data-toc-drawer]');
    var tocList = document.querySelector('[data-toc-list]');
    var tocCloses = document.querySelectorAll('[data-toc-close]');
    var kbdBtn = document.querySelector('[data-floating-kbd-btn]');
    var kbdModal = document.querySelector('[data-kbd-modal]');
    var kbdCloses = document.querySelectorAll('[data-kbd-close]');

    if (!bar) return;

    // 1. İlerleme Güncelleme
    function scrollGuncelle() {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var y = window.scrollY;
      var oran = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
      var yuzde = Math.round(oran * 100);

      if (pctText) pctText.textContent = yuzde + '%';
    }

    if (pctBtn) {
      pctBtn.addEventListener('click', function (e) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 2. Bir Aşağı Ana Başlığa Kaydır (J / ↓)
    function sonrakiBasligaGit() {
      var sections = Array.prototype.slice.call(document.querySelectorAll('main .ml-section, main [data-parca], .ml-endless-ayrac'));
      var curY = window.scrollY + 100;
      var hedef = null;

      for (var i = 0; i < sections.length; i++) {
        var top = sections[i].getBoundingClientRect().top + window.scrollY;
        if (top > curY + 20) {
          hedef = top;
          break;
        }
      }

      if (hedef !== null) {
        window.scrollTo({ top: hedef - 60, behavior: 'smooth' });
      } else {
        window.scrollBy({ top: window.innerHeight * 0.75, behavior: 'smooth' });
      }
    }

    // 3. Bir Yukarı Ana Başlığa Kaydır (K / ↑)
    function oncekiBasligaGit() {
      var sections = Array.prototype.slice.call(document.querySelectorAll('main .ml-section, main [data-parca], .ml-endless-ayrac'));
      var curY = window.scrollY + 40;
      var hedef = null;

      for (var i = sections.length - 1; i >= 0; i--) {
        var top = sections[i].getBoundingClientRect().top + window.scrollY;
        if (top < curY - 20) {
          hedef = top;
          break;
        }
      }

      if (hedef !== null) {
        window.scrollTo({ top: Math.max(0, hedef - 60), behavior: 'smooth' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function (e) {
        e.preventDefault();
        sonrakiBasligaGit();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function (e) {
        e.preventDefault();
        oncekiBasligaGit();
      });
    }

    // 4. Mod Senkronizasyonu
    function modDegistir() {
      var current = document.documentElement.getAttribute('data-ml-mode') || 'sade';
      var next = current === 'teknik' ? 'sade' : 'teknik';
      document.documentElement.setAttribute('data-ml-mode', next);
      try {
        localStorage.setItem('manipulens-mode', next);
      } catch (err) {}
      document.dispatchEvent(new CustomEvent('manipulens:mode-change', { detail: { mode: next } }));
      modGuncelle();
    }

    function modGuncelle() {
      var aktifMod = document.documentElement.getAttribute('data-ml-mode') || 'sade';
      if (modeText) {
        modeText.textContent = aktifMod === 'teknik' ? 'Teknik' : 'Sade';
      }
    }

    if (modeBtn) {
      modeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        modDegistir();
      });
    }

    // 5. Mobil İçindekiler Çekmecesi
    function tocDoldur() {
      if (!tocList) return;
      tocList.innerHTML = '';
      var sections = document.querySelectorAll('main .ml-section, main [data-parca]');
      if (!sections.length) {
        var li = document.createElement('li');
        li.textContent = 'Bu sayfada alt bölüm bulunmuyor.';
        tocList.appendChild(li);
        return;
      }

      sections.forEach(function (s, i) {
        var t = s.querySelector('.ml-section__title') || s.querySelector('h1, h2, h3');
        var baslik = t ? t.textContent.trim() : '';
        if (!baslik) return;

        if (!s.id) {
          s.id = 'ml-sec-' + (i + 1);
        }

        var num = String(i + 1);
        if (num.length < 2) num = '0' + num;

        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + s.id;
        a.className = 'ml-toc-drawer__link';
        a.innerHTML = '<span class="ml-toc-drawer__no">' + num + '</span> <span>' + baslik + '</span>';

        a.addEventListener('click', function () {
          tocKapat();
        });

        li.appendChild(a);
        tocList.appendChild(li);
      });
    }

    function tocAc() {
      tocDoldur();
      if (tocDrawer) {
        tocDrawer.hidden = false;
        tocDrawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }

    function tocKapat() {
      if (tocDrawer) {
        tocDrawer.hidden = true;
        tocDrawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }

    if (tocBtn) {
      tocBtn.addEventListener('click', function (e) {
        e.preventDefault();
        tocAc();
      });
    }

    tocCloses.forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        tocKapat();
      });
    });

    // 6. Kısayol Modalı
    function kbdAc() {
      if (kbdModal) {
        kbdModal.hidden = false;
        kbdModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }
    function kbdKapat() {
      if (kbdModal) {
        kbdModal.hidden = true;
        kbdModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }

    if (kbdBtn) {
      kbdBtn.addEventListener('click', function (e) {
        e.preventDefault();
        if (kbdModal && kbdModal.hidden) kbdAc();
        else kbdKapat();
      });
    }

    kbdCloses.forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        kbdKapat();
      });
    });

    // 7. Global Klavye Gezinme Dinleyicisi (J / K / T / G / ?)
    window.addEventListener('keydown', function (e) {
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

      if (e.key === '?' || (e.shiftKey && e.key === '/')) {
        e.preventDefault();
        if (kbdModal && kbdModal.hidden) kbdAc();
        else kbdKapat();
      } else if (e.key === 't' || e.key === 'T') {
        if (!e.ctrlKey && !e.metaKey && !e.altKey) {
          e.preventDefault();
          modDegistir();
        }
      } else if (e.key === 'g' || e.key === 'G') {
        if (!e.ctrlKey && !e.metaKey && !e.altKey) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } else if (e.key === 'j' || e.key === 'J') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          sonrakiBasligaGit();
        }
      } else if (e.key === 'k' || e.key === 'K') {
        if (!e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          oncekiBasligaGit();
        }
      } else if (e.key === 'Escape') {
        if (kbdModal && !kbdModal.hidden) kbdKapat();
        if (tocDrawer && !tocDrawer.hidden) tocKapat();
      }
    });

    window.addEventListener('scroll', scrollGuncelle, { passive: true });
    document.addEventListener('manipulens:mode-change', modGuncelle);
    modGuncelle();
    scrollGuncelle();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mlYuzenKontrollerKur);
  } else {
    mlYuzenKontrollerKur();
  }
</script>

<style>
  .ml-floating-controls {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 95;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem;
    background: var(--ml-card-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--ml-card-border);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(35, 201, 214, 0.12);
  }

  .ml-floating-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 2.35rem;
    padding: 0 0.75rem;
    background: var(--ml-paper-warm);
    color: var(--ml-ink);
    border: 1px solid var(--ml-line-soft);
    border-radius: 999px;
    font-family: var(--ml-font-body);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--ml-duration) var(--ml-ease), color var(--ml-duration) var(--ml-ease), border-color var(--ml-duration) var(--ml-ease), transform var(--ml-duration) var(--ml-ease);
  }
  .ml-floating-btn:hover {
    background: var(--ml-scan-dim);
    border-color: var(--ml-scan);
  }
  .ml-floating-btn:active {
    transform: scale(0.96);
  }

  .ml-floating-btn--kbd {
    width: 2.35rem;
    padding: 0;
  }
  @media (max-width: 60rem) {
    .ml-floating-btn--kbd { display: none; }
  }

  .ml-floating-btn--toc {
    display: none;
  }
  @media (max-width: 60rem) {
    .ml-floating-btn--toc { display: inline-flex; }
  }

  .ml-floating-btn--mode .ml-floating-btn__icon--teknik { display: none; }
  :global([data-ml-mode='teknik']) .ml-floating-btn--mode .ml-floating-btn__icon--sade { display: none; }
  :global([data-ml-mode='teknik']) .ml-floating-btn--mode .ml-floating-btn__icon--teknik { display: inline; }

  /* Simetrik Gezinme Grubu */
  .ml-floating-nav-pill {
    display: inline-flex;
    align-items: center;
    background: var(--ml-paper-warm);
    border: 1px solid var(--ml-line-soft);
    border-radius: 999px;
    padding: 2px;
    gap: 2px;
  }

  .ml-floating-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 2.15rem;
    padding: 0 0.65rem;
    background: transparent;
    color: var(--ml-ink);
    border: none;
    border-radius: 999px;
    font-family: var(--ml-font-body);
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--ml-duration) var(--ml-ease), color var(--ml-duration) var(--ml-ease), transform var(--ml-duration) var(--ml-ease);
  }
  .ml-floating-nav-btn:hover {
    background: var(--ml-scan-dim);
    color: var(--ml-scan);
  }
  .ml-floating-nav-btn:active {
    transform: scale(0.95);
  }
  .ml-floating-nav-icon {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
  }

  .ml-floating-nav-pct {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.15rem;
    min-width: 2.5rem;
    padding: 0 0.4rem;
    background: var(--ml-card-bg);
    color: var(--ml-scan);
    border: 1px solid var(--ml-card-border);
    border-radius: 999px;
    font-family: var(--ml-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: background var(--ml-duration) var(--ml-ease), color var(--ml-duration) var(--ml-ease);
  }
  .ml-floating-nav-pct:hover {
    background: var(--ml-scan);
    color: #f5f7fb;
  }

  @media (max-width: 60rem) {
    .ml-floating-nav-label { display: none; }
    .ml-floating-nav-btn { padding: 0 0.5rem; width: 2.15rem; }
  }

  /* Mobil İçindekiler Çekmecesi */
  .ml-toc-drawer, .ml-kbd-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-end;
  }
  .ml-kbd-modal {
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .ml-toc-drawer[hidden], .ml-kbd-modal[hidden] { display: none; }
  .ml-toc-drawer__backdrop, .ml-kbd-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 14, 26, 0.6);
    backdrop-filter: blur(6px);
  }
  .ml-toc-drawer__panel, .ml-kbd-modal__panel {
    position: relative;
    width: 100%;
    max-height: 70vh;
    background: var(--ml-paper);
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius) var(--ml-radius) 0 0;
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ml-kbd-modal__panel {
    max-width: 30rem;
    border-radius: var(--ml-radius);
    box-shadow: var(--ml-shadow-lg);
    animation: ml-kbd-pop 0.2s var(--ml-ease);
  }
  @keyframes ml-kbd-pop {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .ml-toc-drawer__header, .ml-kbd-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--ml-line-soft);
    background: var(--ml-paper-warm);
    font-size: 0.92rem;
  }
  .ml-toc-drawer__close, .ml-kbd-modal__close {
    background: none;
    border: none;
    font-size: 1.1rem;
    color: var(--ml-ink-muted);
    cursor: pointer;
    padding: 0.2rem 0.5rem;
  }
  .ml-toc-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1rem 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .ml-toc-drawer__link {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--ml-radius-sm);
    text-decoration: none;
    color: var(--ml-ink);
    font-size: 0.88rem;
    font-weight: 550;
    background: var(--ml-paper-warm);
  }
  .ml-toc-drawer__link:hover {
    background: var(--ml-scan-dim);
    color: var(--ml-scan);
  }
  .ml-toc-drawer__no {
    font-family: var(--ml-font-mono);
    font-size: 0.7rem;
    color: var(--ml-scan);
    font-weight: 700;
  }

  /* Kısayollar Tablosu */
  .ml-kbd-modal__body {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    overflow-y: auto;
    max-height: 60vh;
  }
  .ml-kbd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--ml-line-soft);
  }
  .ml-kbd-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .ml-kbd-keys {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--ml-font-mono);
    font-size: 0.76rem;
    color: var(--ml-ink-muted);
  }
  .ml-kbd-keys kbd {
    padding: 0.15rem 0.45rem;
    background: var(--ml-paper-warm);
    border: 1px solid var(--ml-line-soft);
    border-radius: var(--ml-radius-sm);
    color: var(--ml-ink);
    font-weight: 700;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .ml-kbd-desc {
    font-size: 0.82rem;
    color: var(--ml-ink);
    text-align: right;
  }
</style>
