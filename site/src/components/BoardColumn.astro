---
import BoardCard from './BoardCard.astro';

/** Panonun tek sutunu: Trello listesinin sitedeki karsiligi. */
interface Props {
  ad: string;
  durum: 'yapilacak' | 'yapiliyor' | 'bekliyor' | 'bitti';
  kartlar: any[];
}
const { ad, durum, kartlar } = Astro.props;

const DURUM_ETIKET: Record<string, string> = {
  yapilacak: 'Sırada',
  yapiliyor: 'Şu an çalışılıyor',
  bekliyor: 'Beklemede',
  bitti: 'Bitti',
};
---
<section class="ml-sutun" data-durum={durum}>
  <header class="ml-sutun__bas">
    <h2 class="ml-sutun__ad">{ad}</h2>
    <p class="ml-sutun__meta">
      <span class="ml-sutun__n">{kartlar.length}</span>
      {DURUM_ETIKET[durum]}
    </p>
  </header>

  {kartlar.length === 0 ? (
    <p class="ml-sutun__bos">Bu sütunda kart yok.</p>
  ) : (
    <div class="ml-sutun__kartlar">
      {kartlar.map((k) => (
        <BoardCard
          ad={k.ad}
          aciklama={k.aciklama}
          kimde={k.kimde}
          etiketler={k.etiketler}
          bitis={k.bitis}
          bitisTamam={k.bitisTamam}
          url={k.url}
        />
      ))}
    </div>
  )}
</section>

<style>
  .ml-sutun {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--ml-paper-warm);
    border: var(--ml-border);
    border-radius: var(--ml-radius);
    border-top: 6px solid var(--ml-line);
  }
  .ml-sutun[data-durum='yapiliyor'] { border-top-color: var(--ml-scan); }
  .ml-sutun[data-durum='bitti'] { border-top-color: var(--ml-ok); }
  .ml-sutun[data-durum='bekliyor'] { border-top-color: var(--ml-warn); }

  .ml-sutun__bas { display: flex; flex-direction: column; gap: 0.15rem; }
  .ml-sutun__ad { margin: 0; font-size: var(--ml-step-1); }
  .ml-sutun__meta {
    margin: 0;
    max-width: none;
    font-family: var(--ml-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  .ml-sutun__n { color: var(--ml-ink); }
  .ml-sutun__kartlar { display: flex; flex-direction: column; gap: 0.75rem; }
  .ml-sutun__bos {
    margin: 0;
    max-width: none;
    font-size: var(--ml-step--1);
    color: var(--ml-ink-muted);
    font-style: italic;
  }
</style>
