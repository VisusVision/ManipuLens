---
/**
 * Kendini sina: iki soru, cevap kapali.
 *
 * Ezber testi degil. Cevabin tamami yukaridaki kod parcasinda gorunur - ama
 * ancak okunduysa bilinir. Amac not vermek degil, okuyucunun "anladim" hissini
 * sinamasi.
 *
 * `<details>` kullaniliyor: JavaScript kapaliyken de acilip kapaniyor.
 */
interface Props {
  sorular: { soru: string; cevap: string }[];
}
const { sorular } = Astro.props;
---
<div class="ml-sina">
  <p class="ml-sina__bas">Kendini sına</p>
  {sorular.map((q) => (
    <details>
      <summary>{q.soru}</summary>
      <p>{q.cevap}</p>
    </details>
  ))}
</div>

<style>
  .ml-sina {
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ml-line-soft);
    display: grid;
    gap: 0.5rem;
  }
  .ml-sina__bas {
    margin: 0;
    max-width: none;
    font-family: var(--ml-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  details {
    border: 2px solid var(--ml-line-soft);
    border-radius: var(--ml-radius);
    background: var(--ml-paper);
    padding: 0.55rem 0.8rem;
  }
  details[open] { border-color: var(--ml-scan); }
  summary {
    cursor: pointer;
    font-size: var(--ml-step--1);
    font-weight: 600;
    padding-block: 0.75rem;
    margin-block: -0.55rem;
  }
  summary::marker { color: var(--ml-scan); }
  details p {
    margin: 0.5rem 0 0;
    max-width: var(--ml-measure);
    font-size: var(--ml-step--1);
    color: var(--ml-ink-muted);
  }
</style>
