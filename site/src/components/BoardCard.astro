---
/** Trello panosundan gelen tek gorev karti. */
import { guvenliTrelloUrl } from '../utils/trello-url';
interface Kisi {
  ad: string;
  harfler: string;
}
interface Etiket {
  ad: string;
  renk: string;
}
interface Props {
  ad: string;
  aciklama?: string;
  kimde?: Kisi[];
  etiketler?: Etiket[];
  bitis?: string | null;
  bitisTamam?: boolean;
  url: string;
}
const { ad, aciklama, kimde = [], etiketler = [], bitis, bitisTamam = false, url } = Astro.props;
const kartUrl = guvenliTrelloUrl(url);

const bitisTarihi = bitis ? new Date(bitis) : null;
const gecikti = !!bitisTarihi && !bitisTamam && bitisTarihi.getTime() < Date.now();
const bitisMetni = bitisTarihi
  ? bitisTarihi.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' })
  : null;
---
<article class:list={['ml-kart', gecikti && 'ml-kart--gecikti']}>
  {etiketler.length > 0 && (
    <p class="ml-kart__etiketler">
      {etiketler.map((e) => (
        <span class="ml-kart__etiket" data-renk={e.renk}>{e.ad}</span>
      ))}
    </p>
  )}

  <h3 class="ml-kart__ad">
    {kartUrl ? <a href={kartUrl} rel="noopener noreferrer" target="_blank">{ad}</a> : ad}
  </h3>

  {aciklama && <p class="ml-kart__aciklama">{aciklama}</p>}

  <div class="ml-kart__alt">
    {kimde.length > 0 ? (
      <p class="ml-kart__kisiler">
        {kimde.map((k) => (
          <span class="ml-kart__kisi" title={k.ad}>
            <span class="ml-kart__harf" aria-hidden="true">{k.harfler}</span>
            {k.ad}
          </span>
        ))}
      </p>
    ) : (
      <p class="ml-kart__kisiler ml-kart__kisiler--bos">Kimse üstlenmemiş</p>
    )}

    {bitisMetni && (
      <p class="ml-kart__bitis">
        {bitisTamam ? '✓ ' : gecikti ? 'Gecikti · ' : 'Bitiş · '}
        {bitisMetni}
      </p>
    )}
  </div>
</article>

<style>
  .ml-kart {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem 1.25rem 1.25rem;
    background: var(--ml-card-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius);
    box-shadow: var(--ml-shadow-sm);
    transition: transform var(--ml-duration) var(--ml-ease),
                box-shadow var(--ml-duration) var(--ml-ease),
                border-color var(--ml-duration) var(--ml-ease);
  }
  .ml-kart:hover {
    transform: translateY(-2px);
    box-shadow: var(--ml-shadow-md);
    border-color: var(--ml-scan);
  }
  .ml-kart--gecikti { border-left: 5px solid var(--ml-risk); }

  .ml-kart__etiketler { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0; max-width: none; }
  .ml-kart__etiket {
    font-family: var(--ml-font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--ml-line-soft);
    border-radius: var(--ml-radius-sm);
    color: var(--ml-ink-muted);
    background: var(--ml-paper);
  }
  .ml-kart__etiket[data-renk='green'] { border-color: var(--ml-ok); color: var(--ml-ok); background: rgba(0, 110, 99, 0.08); }
  .ml-kart__etiket[data-renk='yellow'],
  .ml-kart__etiket[data-renk='orange'] { border-color: var(--ml-warn); color: var(--ml-warn); background: rgba(168, 78, 0, 0.08); }
  .ml-kart__etiket[data-renk='red'] { border-color: var(--ml-risk); color: var(--ml-risk); background: rgba(166, 0, 78, 0.08); }
  .ml-kart__etiket[data-renk='blue'],
  .ml-kart__etiket[data-renk='sky'] { border-color: var(--ml-scan); color: var(--ml-scan); background: var(--ml-scan-dim); }

  .ml-kart__ad { margin: 0; font-size: var(--ml-step-0); line-height: 1.3; font-weight: 700; }
  .ml-kart__ad a { text-decoration: none; }
  .ml-kart__ad a:hover { text-decoration: underline; text-decoration-color: var(--ml-scan); }

  .ml-kart__aciklama {
    margin: 0;
    max-width: none;
    font-size: var(--ml-step--1);
    color: var(--ml-ink-muted);
    line-height: 1.55;
  }

  .ml-kart__alt {
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px solid var(--ml-line-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    align-items: center;
    justify-content: space-between;
  }
  .ml-kart__kisiler { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; max-width: none; }
  .ml-kart__kisi {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--ml-step--1);
  }
  .ml-kart__kisiler--bos { font-size: var(--ml-step--1); color: var(--ml-ink-muted); font-style: italic; }
  .ml-kart__harf {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--ml-navy);
    color: #f5f7fb;
    font-family: var(--ml-font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: var(--ml-shadow-sm);
  }
  .ml-kart__bitis {
    margin: 0;
    max-width: none;
    font-family: var(--ml-font-mono);
    font-size: 0.68rem;
    color: var(--ml-ink-muted);
    font-weight: 600;
  }
  .ml-kart--gecikti .ml-kart__bitis { color: var(--ml-risk); font-weight: 700; }
</style>
