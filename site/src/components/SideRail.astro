---
/**
 * Ana gezinme rayi: masaustunde her zaman acik durur (numara + baslik birlikte),
 * hover yalnizca vurgu degistirir. Aktif rotanin altina o sayfanin bolumleri
 * cikar ve kaydirdikca 01, 02, 03 diye kendiliginden ilerler - site tek uzun
 * sayfa gibi okunur.
 */
interface NavItem {
  href: string;
  label: string;
}

interface Props {
  nav: NavItem[];
  current: string;
  base: string;
}

const { nav, current, base } = Astro.props;
const no = (n: number) => String(n).padStart(2, '0');

const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '');
  return target === base
    ? current === base
    : current === target || current.startsWith(`${target}/`);
};

const getCategory = (index: number) => {
  if (index === 0) return 'Temel Rehber';
  if (index === 2) return 'Sözlük & Pano';
  if (index === 4) return 'Mimari & Kod';
  if (index === 9) return 'Kılavuz & Belgeler';
  return null;
};
---

<aside class="ml-side-rail" aria-label="ManipuLens gezinme rayı">
  <a class="ml-side-rail__brand" href={`${base}/`} title="ManipuLens başlangıç">
    <span class="ml-side-rail__lens" aria-hidden="true"></span>
    <span class="ml-side-rail__brand-text">
      <strong>ManipuLens</strong>
      <small>yaşayan rehber</small>
    </span>
  </a>

  <nav aria-label="Ana bölümler">
    <ol class="ml-side-rail__main">
      {nav.map((n, i) => {
        const cat = getCategory(i);
        return (
          <>
            {cat && (
              <li class="ml-side-rail__cat" aria-hidden="true">
                <span>{cat}</span>
              </li>
            )}
            <li>
              <a
                class="ml-side-rail__route"
                href={n.href}
                aria-current={isCurrent(n.href) ? 'page' : undefined}
                data-rail-route={isCurrent(n.href) ? '' : undefined}
              >
                <span class="ml-side-rail__no" aria-hidden="true">{no(i + 1)}</span>
                <span class="ml-side-rail__label">{n.label}</span>
              </a>
            </li>
          </>
        );
      })}
    </ol>
  </nav>

  <div class="ml-side-rail__progress" aria-hidden="true">
    <span data-rail-progress></span>
  </div>
</aside>

<script is:inline>
  function mlRayKur() {
    var ray = document.querySelector('.ml-side-rail');
    if (!ray) return;

    var dolgu = ray.querySelector('[data-rail-progress]');

    function ilerleme() {
      if (!dolgu) return;
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var oran = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      dolgu.style.height = oran * 100 + '%';
    }

    // Aktif rotanin altina o sayfanin bolum listesini kur. Sunucuda uretmiyoruz:
    // her sayfa kendi bolumlerini tasiyor, listeyi tek yerde okumak 25 sayfayi
    // elle senkron tutmaktan ucuz.
    function basligi(s) {
      var t = s.querySelector('.ml-section__title') || s.querySelector('h1, h2, h3');
      return t ? t.textContent.trim() : '';
    }

    // Sayfa iskeleti `.ml-section`; /parcalar gibi sayfalar ek olarak kendi
    // bloklarini `data-parca` ile isaretler. Ikisi de belge sirasinda toplanir.
    var bolumler = Array.prototype.slice
      .call(document.querySelectorAll('main .ml-section, main [data-parca]'))
      .filter(function (s) {
        return basligi(s) !== '';
      });

    var baglar = [];

    // Astro stilleri `data-astro-cid-*` damgasiyla kapsamli. JS ile uretilen
    // dugumde bu damga yoksa rayin hicbir kurali tutmaz ve liste ham madde
    // imli baglantilara doner - damgayi raydan okuyup her dugume basiyoruz.
    var damga = null;
    for (var d = 0; d < ray.attributes.length; d++) {
      if (ray.attributes[d].name.indexOf('data-astro-cid-') === 0) {
        damga = ray.attributes[d].name;
        break;
      }
    }
    function damgala(el) {
      if (damga) el.setAttribute(damga, '');
      return el;
    }

    function listeKur(kok, kaynak) {
      var eskiKonteyner = ray.querySelector('.ml-side-rail__parts-wrap');
      if (eskiKonteyner) eskiKonteyner.parentNode.removeChild(eskiKonteyner);
      baglar = [];
      bolumler = kaynak;
      if (!kok || kaynak.length < 2) return;

      var wrap = damgala(document.createElement('div'));
      wrap.className = 'ml-side-rail__parts-wrap';

      var toggleBtn = damgala(document.createElement('button'));
      toggleBtn.type = 'button';
      toggleBtn.className = 'ml-side-rail__toggle';
      toggleBtn.setAttribute('aria-expanded', 'true');
      var sayi = kaynak.length;
      toggleBtn.innerHTML = '<span class="ml-side-rail__toggle-icon" aria-hidden="true">▾</span> <span class="ml-side-rail__toggle-text">' + sayi + ' alt başlığı gizle</span>';

      var liste = damgala(document.createElement('ol'));
      liste.className = 'ml-side-rail__parts';
      liste.setAttribute('aria-label', 'Bu sayfanın bölümleri');

      toggleBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var acik = toggleBtn.getAttribute('aria-expanded') === 'true';
        if (acik) {
          toggleBtn.setAttribute('aria-expanded', 'false');
          liste.hidden = true;
          toggleBtn.querySelector('.ml-side-rail__toggle-icon').textContent = '▸';
          toggleBtn.querySelector('.ml-side-rail__toggle-text').textContent = sayi + ' alt başlığı göster';
        } else {
          toggleBtn.setAttribute('aria-expanded', 'true');
          liste.hidden = false;
          toggleBtn.querySelector('.ml-side-rail__toggle-icon').textContent = '▾';
          toggleBtn.querySelector('.ml-side-rail__toggle-text').textContent = sayi + ' alt başlığı gizle';
        }
      });

      kaynak.forEach(function (s, i) {
        if (!s.id) {
          var sayac = i + 1;
          while (document.getElementById('ml-bolum-' + sayac)) sayac++;
          s.id = 'ml-bolum-' + sayac;
        }
        var num = String(i + 1);
        if (num.length < 2) num = '0' + num;

        var li = damgala(document.createElement('li'));
        var a = damgala(document.createElement('a'));
        a.href = '#' + s.id;
        a.dataset.railSection = s.id;

        var n = damgala(document.createElement('span'));
        n.setAttribute('aria-hidden', 'true');
        n.textContent = num;
        var t = damgala(document.createElement('span'));
        t.textContent = basligi(s);

        a.appendChild(n);
        a.appendChild(t);
        li.appendChild(a);
        liste.appendChild(li);
        baglar.push(a);
      });

      wrap.appendChild(toggleBtn);
      wrap.appendChild(liste);
      kok.parentNode.appendChild(wrap);
      aktif = null;
    }

    listeKur(document.querySelector('[data-rail-route]'), bolumler);

    // Sonsuz kaydirma aktif rotayi degistirdiginde ray yeniden kuruluyor:
    // koyu satir o rotaya gecer, altina o rotanin bolumleri gelir.
    window.mlRayRota = function (href, yeniBolumler) {
      var hedef = href.replace(/\/$/, '');
      var secili = null;
      Array.prototype.forEach.call(ray.querySelectorAll('.ml-side-rail__route'), function (a) {
        var kendi = a.getAttribute('href').replace(/\/$/, '');
        if (kendi === hedef) {
          a.setAttribute('aria-current', 'page');
          secili = a;
        } else {
          a.removeAttribute('aria-current');
        }
      });
      listeKur(secili, yeniBolumler || []);
      olc();
      if (secili) {
        var rayKutu = ray.getBoundingClientRect();
        var kutu = secili.getBoundingClientRect();
        if (kutu.top < rayKutu.top + 8 || kutu.bottom > rayKutu.bottom - 8) {
          ray.scrollTop += kutu.top - rayKutu.top - rayKutu.height / 2;
        }
      }
    };

    var aktif = null;

    function isaretle(id) {
      if (id === aktif) return;
      aktif = id;
      var isaretli = null;
      baglar.forEach(function (a) {
        if (a.dataset.railSection === id) {
          a.setAttribute('aria-current', 'location');
          isaretli = a;
        } else {
          a.removeAttribute('aria-current');
        }
      });

      // Uzun listelerde (17 bolumlu kod sayfasi) aktif satir rayin disina
      // cikabiliyor; yalniz gorunmuyorsa rayi kaydiriyoruz, sayfayi degil.
      if (isaretli) {
        var rayKutu = ray.getBoundingClientRect();
        var kutu = isaretli.getBoundingClientRect();
        if (kutu.top < rayKutu.top + 8 || kutu.bottom > rayKutu.bottom - 8) {
          ray.scrollTop += kutu.top - rayKutu.top - rayKutu.height / 2;
        }
      }
    }

    // Ekranin ust ucte birini gecmis son bolum aktiftir. Dogrudan olcum, gozlemci
    // kurmaktan hem daha ongorulebilir hem de bolum sayisi az oldugu icin ucuz.
    function olc() {
      ilerleme();
      if (!bolumler.length || !baglar.length) return;
      var esik = window.innerHeight * 0.3;
      var secili = bolumler[0].id;
      for (var i = 0; i < bolumler.length; i++) {
        if (bolumler[i].getBoundingClientRect().top <= esik) secili = bolumler[i].id;
      }
      isaretle(secili);
    }

    // requestAnimationFrame'e baglamiyoruz: arka plan sekmesinde ve enerji
    // tasarrufu modunda kare dongusu duruyor, ray da onunla birlikte donuyor.
    window.addEventListener('scroll', olc, { passive: true });
    document.addEventListener('scroll', olc, { passive: true, capture: true });
    window.addEventListener('resize', olc, { passive: true });
    window.addEventListener('hashchange', olc);
    // Sade/teknik modu bolum yuksekliklerini degistirir; olcumu yenile.
    document.addEventListener('manipulens:mode-change', olc);
    olc();
  }

  // Ray <main>'den once basiliyor; bolumler ayristirilmadan liste kurulamaz.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mlRayKur);
  } else {
    mlRayKur();
  }
</script>

<style>
  .ml-side-rail {
    --rail-genislik: 15.5rem;
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    width: var(--rail-genislik);
    min-height: 100vh;
    overflow: hidden auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    display: flex;
    flex-direction: column;
    color: var(--ml-ink);
    background-color: var(--ml-paper);
    background-image: var(--ml-grain);
    border-right: var(--ml-border);
  }
  .ml-side-rail__brand {
    flex: none;
    min-height: 4.25rem;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    align-items: center;
    text-decoration: none;
    border-bottom: 1px solid var(--ml-line-soft);
  }
  .ml-side-rail__lens {
    place-self: center;
    width: 1.45rem;
    height: 1.45rem;
    border: 2px solid var(--ml-ink);
    border-radius: 50%;
    box-shadow: inset 0 0 0 4px var(--ml-scan-dim);
    position: relative;
  }
  .ml-side-rail__lens::after {
    content: '';
    position: absolute;
    width: 0.6rem;
    height: 2px;
    right: -0.45rem;
    bottom: -0.2rem;
    background: var(--ml-ink);
    transform: rotate(45deg);
    transform-origin: left center;
  }
  .ml-side-rail__brand-text { display: grid; line-height: 1.1; }
  .ml-side-rail__brand-text strong { font-family: var(--ml-font-display); font-size: 1.05rem; }
  .ml-side-rail__brand-text small {
    margin-top: 0.2rem;
    font-family: var(--ml-font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  .ml-side-rail nav { padding-block: 0.55rem; }
  .ml-side-rail ol { list-style: none; margin: 0; padding: 0; }
  .ml-side-rail__cat {
    padding: 0.8rem 1rem 0.35rem 1rem;
    font-family: var(--ml-font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-scan);
    display: flex;
    align-items: center;
  }
  .ml-side-rail__cat span {
    display: inline-block;
    padding: 0.15rem 0.4rem;
    background: var(--ml-scan-dim);
    border-radius: var(--ml-radius-sm);
  }
  .ml-side-rail__route {
    min-height: 2.35rem;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    align-items: center;
    color: var(--ml-ink-muted);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: color 0.14s ease, background 0.14s ease, border-color 0.14s ease;
  }
  .ml-side-rail__route:hover { color: var(--ml-ink); background: var(--ml-paper-warm); }
  .ml-side-rail__route[aria-current='page'] {
    color: #f5f7fb;
    background: var(--ml-navy);
    border-left-color: var(--ml-scan);
    font-weight: 700;
  }
  .ml-side-rail__no {
    justify-self: center;
    font-family: var(--ml-font-mono);
    font-size: 0.64rem;
    color: var(--ml-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .ml-side-rail__route[aria-current='page'] .ml-side-rail__no { color: #23c9d6; }
  .ml-side-rail__parts-wrap {
    padding: 0.25rem 0 0.5rem 2.8rem;
    border-left: 3px solid var(--ml-line-soft);
  }
  .ml-side-rail__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    margin: 0.2rem 0 0.35rem 0.2rem;
    background: var(--ml-scan-dim);
    color: var(--ml-scan);
    font-family: var(--ml-font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius-sm);
    cursor: pointer;
    transition: background var(--ml-duration) var(--ml-ease), color var(--ml-duration) var(--ml-ease);
  }
  .ml-side-rail__toggle:hover {
    background: var(--ml-scan);
    color: #f5f7fb;
  }
  .ml-side-rail__toggle-icon {
    font-size: 0.75rem;
    line-height: 1;
  }
  .ml-side-rail__parts {
    padding: 0.1rem 0 0.2rem 0.4rem !important;
    margin-left: 0;
  }
  .ml-side-rail__parts a {
    position: relative;
    display: grid;
    grid-template-columns: 1.65rem 1fr;
    gap: 0.3rem;
    align-items: baseline;
    padding: 0.34rem 0.6rem 0.34rem 0.35rem;
    margin-left: -0.35rem;
    color: var(--ml-ink-muted);
    text-decoration: none;
    font-size: 0.75rem;
    line-height: 1.3;
    border-radius: 0 var(--ml-radius) var(--ml-radius) 0;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .ml-side-rail__parts a:hover { color: var(--ml-ink); background: var(--ml-scan-dim); }
  .ml-side-rail__parts a span:first-child {
    font-family: var(--ml-font-mono);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    color: var(--ml-ink-muted);
  }

  /* Aktif bolum: dolgu + sol isaret + kalin numara. Ince kenarlik yeterince
     gorunmuyordu; okuyucu tek bakista hangi bolumde oldugunu gormeli. */
  .ml-side-rail__parts a[aria-current] {
    color: #f5f7fb;
    background: var(--ml-scan);
    font-weight: 700;
  }
  .ml-side-rail__parts a[aria-current] span:first-child { color: #f5f7fb; }
  .ml-side-rail__parts a[aria-current]::before {
    content: '';
    position: absolute;
    left: -0.6rem;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ml-scan);
    transform: translateY(-50%);
  }
  .ml-side-rail__progress {
    position: fixed;
    inset: 0 auto 0 calc(var(--rail-genislik) - 3px);
    width: 3px;
    pointer-events: none;
    background: var(--ml-line-soft);
  }
  .ml-side-rail__progress span {
    display: block;
    width: 100%;
    height: 0;
    background: var(--ml-scan);
  }
  @media (max-width: 60rem) {
    .ml-side-rail { display: none; }
    .ml-side-rail__progress { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ml-side-rail, .ml-side-rail * { transition: none !important; }
  }
</style>
