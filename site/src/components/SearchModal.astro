---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 1. Sayfalar
const sayfalar = [
  { baslik: 'Başlangıç', aciklama: 'ManipuLens nedir, neyi çözer, neden var?', href: `${base}/`, kategori: 'Sayfa', simge: '🏠' },
  { baslik: 'Nasıl Çalışır?', aciklama: 'Sistemin uçtan uca akışı, DOM taramadan raporlamaya', href: `${base}/nasil-calisir`, kategori: 'Sayfa', simge: '🔄' },
  { baslik: 'Sözlük', aciklama: '42 manipülasyon, yapay zeka ve sistem terimi', href: `${base}/sozluk`, kategori: 'Sayfa', simge: '📖' },
  { baslik: 'Canlı Pano', aciklama: 'Ajanların gerçek zamanlı durumları ve analiz kuyruğu', href: `${base}/pano`, kategori: 'Sayfa', simge: '📊' },
  { baslik: 'Parçalar', aciklama: '6 ana mimari blok (Uzantı, Sunucu, Model, vb.)', href: `${base}/parcalar`, kategori: 'Sayfa', simge: '🧩' },
  { baslik: 'Ajan Atlası', aciklama: '6 uzmanlaşmış manipülasyon tespit ajanı', href: `${base}/ajanlar`, kategori: 'Sayfa', simge: '⚡' },
  { baslik: 'Kod Okuma', aciklama: 'Gerçek kaynak kod kesitleri ve satır satır analiz', href: `${base}/kod`, kategori: 'Sayfa', simge: '💻' },
  { baslik: 'Depo Haritası', aciklama: 'Depodaki dosyaların görevi ve kritiklik analizi', href: `${base}/dosyalar`, kategori: 'Sayfa', simge: '🗂️' },
  { baslik: 'Güncellemeler', aciklama: 'Geliştirme günlükleri, sürümler ve yenilikler', href: `${base}/guncellemeler`, kategori: 'Sayfa', simge: '🚀' },
  { baslik: 'Kurulum Kılavuzu', aciklama: 'Yerel ve sunucu kurulum adımları', href: `${base}/kurulum`, kategori: 'Sayfa', simge: '🛠️' },
  { baslik: 'Mimari Kararlar', aciklama: 'Tasarım tercihleri ve ADR kayıtları', href: `${base}/kararlar`, kategori: 'Sayfa', simge: '⚖️' },
  { baslik: 'Gizlilik ve Güvenlik', aciklama: 'Veri saklama, yerel işleme ve izinler', href: `${base}/gizlilik`, kategori: 'Sayfa', simge: '🔒' },
  { baslik: 'Sıkça Sorulan Sorular', aciklama: 'SSS, yaygın sorular ve yanıtları', href: `${base}/sss`, kategori: 'Sayfa', simge: '❓' },
  { baslik: 'Yol Haritası', aciklama: 'Gelecek planları ve özellik takvimi', href: `${base}/yol-haritasi`, kategori: 'Sayfa', simge: '🗺️' },
];

// 2. Ajanlar
const ajanlarRaw = await getCollection('ajanlar');
const ajanlar = ajanlarRaw.map((a) => ({
  baslik: `${a.data.title} (${a.data.manipulation_type})`,
  aciklama: a.data.kisaca,
  href: `${base}/ajanlar/${a.id}`,
  kategori: 'Ajan',
  simge: '⚡',
}));

// 3. Parçalar
const parcalarRaw = await getCollection('parcalar');
const parcalar = parcalarRaw.map((p) => ({
  baslik: p.data.title,
  aciklama: p.data.kisaca,
  href: `${base}/parcalar/${p.id}`,
  kategori: 'Parça',
  simge: '🧩',
}));

// 4. Kod Kesitleri
const kodlarRaw = await getCollection('kod');
const kodlar = kodlarRaw.map((k) => ({
  baslik: `${k.data.title} (${k.data.dosya})`,
  aciklama: k.data.ne_yapiyor,
  href: `${base}/kod#${k.id}`,
  kategori: 'Kod',
  simge: '💻',
}));

// 5. Sözlük Terimleri
const sozlukRaw = await getCollection('sozluk');
const sozluk = sozlukRaw.map((s) => ({
  baslik: `${s.data.terim} (${s.data.alan})`,
  aciklama: s.data.kisaca || '',
  href: `${base}/sozluk#${s.id}`,
  kategori: 'Sözlük',
  simge: '🏷️',
}));

const tumVeriler = [...sayfalar, ...ajanlar, ...parcalar, ...kodlar, ...sozluk];
---

<!-- Spotlight Arama Tetikleyici Butonu -->
<button
  type="button"
  class="ml-search-trigger"
  data-search-trigger
  aria-label="Rehberde ara (Ctrl+K)"
  title="Rehberde ara (Ctrl+K)"
>
  <span class="ml-search-trigger__icon" aria-hidden="true">🔍</span>
  <span class="ml-search-trigger__label">Ara...</span>
  <kbd class="ml-search-trigger__kbd">Ctrl K</kbd>
</button>

<!-- Spotlight Arama Modalı -->
<div class="ml-search-modal" data-search-modal hidden aria-hidden="true">
  <div class="ml-search-modal__backdrop" data-search-close></div>

  <div class="ml-search-modal__panel" role="dialog" aria-modal="true" aria-label="Rehberde hızlı arama">
    <div class="ml-search-modal__header">
      <span class="ml-search-modal__icon" aria-hidden="true">🔍</span>
      <input
        type="search"
        class="ml-search-modal__input"
        data-search-input
        placeholder="Terim, kod parçası, ajan veya bölüm ara..."
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
      <button type="button" class="ml-search-modal__close" data-search-close aria-label="Kapat">
        <kbd>ESC</kbd>
      </button>
    </div>

    <div class="ml-search-modal__body">
      <div class="ml-search-modal__results" data-search-results>
        <!-- Dinamik Sonuçlar -->
      </div>
      <div class="ml-search-modal__empty" data-search-empty hidden>
        <p>Aramanızla eşleşen bir sonuç bulunamadı.</p>
        <small>Farklı bir terim, dosya adı veya konu deneyebilirsiniz.</small>
      </div>
    </div>

    <div class="ml-search-modal__footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> Gezin</span>
      <span><kbd>↵</kbd> Seç</span>
      <span><kbd>ESC</kbd> Kapat</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ tumVeriler }}>
  function mlAramaKur() {
    var modal = document.querySelector('[data-search-modal]');
    var input = document.querySelector('[data-search-input]');
    var sonuclarKutusu = document.querySelector('[data-search-results]');
    var bosKutusu = document.querySelector('[data-search-empty]');
    var tetikleyiciler = document.querySelectorAll('[data-search-trigger]');
    var kapaticilar = document.querySelectorAll('[data-search-close]');

    if (!modal || !input || !sonuclarKutusu) return;

    var seciliIndex = 0;
    var mevcutSonuclar = [];
    var oncekiOdak = null;
    var oncekiOverflow = '';

    function ac() {
      oncekiOdak = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      oncekiOverflow = document.body.style.overflow;
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      input.value = '';
      ara('');
      setTimeout(function () {
        input.focus();
      }, 50);
    }

    function kapat() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = oncekiOverflow;
      if (oncekiOdak && document.contains(oncekiOdak)) oncekiOdak.focus();
    }

    function turkceKucult(s) {
      return (s || '')
        .toLowerCase()
        .replace(/ı/g, 'i')
        .replace(/ğ/g, 'g')
        .replace(/ü/g, 'u')
        .replace(/ş/g, 's')
        .replace(/ö/g, 'o')
        .replace(/ç/g, 'c');
    }

    function ara(sorgu) {
      var temiz = turkceKucult(sorgu.trim());
      if (!temiz) {
        mevcutSonuclar = tumVeriler.slice(0, 8);
      } else {
        mevcutSonuclar = tumVeriler.filter(function (item) {
          var b = turkceKucult(item.baslik);
          var a = turkceKucult(item.aciklama);
          var k = turkceKucult(item.kategori);
          return b.indexOf(temiz) !== -1 || a.indexOf(temiz) !== -1 || k.indexOf(temiz) !== -1;
        }).slice(0, 15);
      }

      ciz();
    }

    function ciz() {
      sonuclarKutusu.innerHTML = '';
      seciliIndex = 0;

      if (mevcutSonuclar.length === 0) {
        if (bosKutusu) bosKutusu.hidden = false;
        return;
      }
      if (bosKutusu) bosKutusu.hidden = true;

      var gruplar = {};
      mevcutSonuclar.forEach(function (item, idx) {
        if (!gruplar[item.kategori]) gruplar[item.kategori] = [];
        gruplar[item.kategori].push({ item: item, globalIndex: idx });
      });

      Object.keys(gruplar).forEach(function (kat) {
        var katBaslik = document.createElement('div');
        katBaslik.className = 'ml-search-group-title';
        katBaslik.textContent = kat;
        sonuclarKutusu.appendChild(katBaslik);

        gruplar[kat].forEach(function (g) {
          var a = document.createElement('a');
          a.className = 'ml-search-item';
          a.href = g.item.href;
          a.dataset.searchIndex = g.globalIndex;
          if (g.globalIndex === seciliIndex) {
            a.classList.add('ml-search-item--active');
          }

          var simge = document.createElement('span');
          simge.className = 'ml-search-item__icon';
          simge.textContent = g.item.simge || '📄';

          var icerik = document.createElement('div');
          icerik.className = 'ml-search-item__content';

          var baslik = document.createElement('strong');
          baslik.className = 'ml-search-item__title';
          baslik.textContent = g.item.baslik;

          var aciklama = document.createElement('span');
          aciklama.className = 'ml-search-item__desc';
          aciklama.textContent = g.item.aciklama;

          icerik.appendChild(baslik);
          if (g.item.aciklama) icerik.appendChild(aciklama);

          var ok = document.createElement('span');
          ok.className = 'ml-search-item__arrow';
          ok.textContent = '↵';

          a.appendChild(simge);
          a.appendChild(icerik);
          a.appendChild(ok);

          a.addEventListener('mouseenter', function () {
            vurgula(g.globalIndex);
          });

          a.addEventListener('click', function () {
            kapat();
          });

          sonuclarKutusu.appendChild(a);
        });
      });
    }

    function vurgula(idx) {
      seciliIndex = Math.max(0, Math.min(idx, mevcutSonuclar.length - 1));
      var items = sonuclarKutusu.querySelectorAll('.ml-search-item');
      items.forEach(function (el) {
        if (Number(el.dataset.searchIndex) === seciliIndex) {
          el.classList.add('ml-search-item--active');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('ml-search-item--active');
        }
      });
    }

    tetikleyiciler.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        ac();
      });
    });

    kapaticilar.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        kapat();
      });
    });

    input.addEventListener('input', function () {
      ara(input.value);
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        vurgula(seciliIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        vurgula(seciliIndex - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (mevcutSonuclar[seciliIndex]) {
          var hedefHref = mevcutSonuclar[seciliIndex].href;
          kapat();
          window.location.href = hedefHref;
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        kapat();
      }
    });

    window.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.hidden) ac();
        else kapat();
      } else if (e.key === 'Escape' && !modal.hidden) {
        kapat();
      } else if (e.key === 'Tab' && !modal.hidden) {
        var odaklanabilir = Array.from(modal.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )).filter(function (el) {
          return el instanceof HTMLElement && !el.hidden && el.getClientRects().length > 0;
        });
        if (!odaklanabilir.length) return;
        var ilk = odaklanabilir[0];
        var son = odaklanabilir[odaklanabilir.length - 1];
        if (e.shiftKey && document.activeElement === ilk) {
          e.preventDefault();
          son.focus();
        } else if (!e.shiftKey && document.activeElement === son) {
          e.preventDefault();
          ilk.focus();
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mlAramaKur);
  } else {
    mlAramaKur();
  }
</script>

<style>
  .ml-search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background: var(--ml-paper-warm);
    color: var(--ml-ink-muted);
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius);
    font-family: var(--ml-font-body);
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color var(--ml-duration) var(--ml-ease), background var(--ml-duration) var(--ml-ease), color var(--ml-duration) var(--ml-ease);
  }
  .ml-search-trigger:hover {
    border-color: var(--ml-scan);
    background: var(--ml-scan-dim);
    color: var(--ml-ink);
  }
  .ml-search-trigger__icon { font-size: 0.85rem; }
  .ml-search-trigger__label { font-weight: 550; }
  .ml-search-trigger__kbd {
    font-family: var(--ml-font-mono);
    font-size: 0.65rem;
    padding: 0.1rem 0.35rem;
    background: rgba(0, 0, 0, 0.06);
    border: 1px solid var(--ml-line-soft);
    border-radius: var(--ml-radius-sm);
    color: var(--ml-ink-muted);
  }
  :global([data-ml-mode='teknik']) .ml-search-trigger__kbd {
    background: rgba(255, 255, 255, 0.1);
  }

  .ml-search-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 8vh, 6rem) 1rem 1rem;
  }
  .ml-search-modal[hidden] {
    display: none;
  }
  .ml-search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 14, 26, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .ml-search-modal__panel {
    position: relative;
    width: 100%;
    max-width: 38rem;
    background: var(--ml-paper);
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(35, 201, 214, 0.15);
    display: flex;
    flex-direction: column;
    max-height: 75vh;
    overflow: hidden;
    animation: ml-modal-slide 0.2s var(--ml-ease);
  }
  @keyframes ml-modal-slide {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(-10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .ml-search-modal__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--ml-line-soft);
    background: var(--ml-paper-warm);
  }
  .ml-search-modal__icon { font-size: 1.1rem; opacity: 0.7; }
  .ml-search-modal__input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--ml-font-body);
    font-size: 1rem;
    color: var(--ml-ink);
    outline: none;
  }
  .ml-search-modal__input::placeholder {
    color: var(--ml-ink-muted);
    font-size: 0.92rem;
  }
  .ml-search-modal__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.2rem;
  }
  .ml-search-modal__close kbd {
    font-family: var(--ml-font-mono);
    font-size: 0.68rem;
    padding: 0.15rem 0.4rem;
    background: rgba(0, 0, 0, 0.08);
    border: 1px solid var(--ml-line-soft);
    border-radius: var(--ml-radius-sm);
    color: var(--ml-ink-muted);
  }

  .ml-search-modal__body {
    flex: 1;
    overflow-y: auto;
    padding: 0.6rem 0.75rem;
    scrollbar-width: thin;
  }
  .ml-search-group-title {
    padding: 0.6rem 0.6rem 0.25rem;
    font-family: var(--ml-font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ml-scan);
  }
  .ml-search-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--ml-radius-sm);
    text-decoration: none;
    color: var(--ml-ink);
    transition: background var(--ml-duration) var(--ml-ease);
  }
  .ml-search-item:hover,
  .ml-search-item--active {
    background: var(--ml-scan-dim);
    color: var(--ml-ink);
  }
  .ml-search-item__icon {
    font-size: 1.1rem;
    flex: none;
  }
  .ml-search-item__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .ml-search-item__title {
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ml-search-item__desc {
    font-size: 0.76rem;
    color: var(--ml-ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ml-search-item__arrow {
    font-family: var(--ml-font-mono);
    font-size: 0.8rem;
    color: var(--ml-scan);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--ml-duration) var(--ml-ease), transform var(--ml-duration) var(--ml-ease);
  }
  .ml-search-item:hover .ml-search-item__arrow,
  .ml-search-item--active .ml-search-item__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .ml-search-modal__empty {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--ml-ink-muted);
  }
  .ml-search-modal__empty p {
    margin: 0 0 0.4rem;
    font-weight: 600;
    color: var(--ml-ink);
  }
  .ml-search-modal__empty small {
    font-size: 0.8rem;
  }

  .ml-search-modal__footer {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.55rem 1.15rem;
    background: var(--ml-paper-warm);
    border-top: 1px solid var(--ml-line-soft);
    font-family: var(--ml-font-mono);
    font-size: 0.68rem;
    color: var(--ml-ink-muted);
  }
  .ml-search-modal__footer kbd {
    padding: 0.1rem 0.3rem;
    background: rgba(0, 0, 0, 0.06);
    border: 1px solid var(--ml-line-soft);
    border-radius: var(--ml-radius-sm);
    margin-right: 0.3rem;
  }
</style>
