---
/**
 * Sonsuz rota kaydirmasi: sayfa sonuna gelindiginde sonraki rotanin icerigi
 * ayni <main> icine ekleniyor. Site tek uzun sayfa gibi okunuyor; ray, adres
 * cubugu ve sekme basligi hangi rotadaysan onu gosteriyor.
 *
 * Getirilen HTML'in kendi satir ici betikleri innerHTML ile calismaz; her
 * betik yeni bir dugum olarak yeniden basiliyor. Sozluk balonlari ve gorunum
 * animasyonu da yeni blok icin yeniden taraniyor.
 */
import { iconSvg } from '../lib/icons';

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  nav: NavItem[];
  current: string;
}

const { nav, current } = Astro.props;
---

<div class="ml-chapter-toast" data-chapter-toast aria-live="polite"></div>

<div class="ml-endless-son" data-endless-son hidden>
  <p>Rehberin sonu. Yukarı dönebilir ya da raydan bir bölüme atlayabilirsin.</p>
</div>

<script is:inline define:vars={{ nav, current, ikonBolum: iconSvg('bolum', 15) }}>
  function mlSonsuzKur() {
    var main = document.getElementById('icerik');
    if (!main) return;

    var duz = function (h) {
      return h.replace(/\/$/, '');
    };
    var sira = nav.map(function (n) {
      return { href: duz(n.href), label: n.label };
    });

    // Alt rotalarda (ornegin /parcalar/uzanti) zincir baslatmiyoruz: okuyucu
    // oraya bilerek indi, altina baska sayfalar eklemek yon duygusunu bozar.
    var index = -1;
    for (var i = 0; i < sira.length; i++) {
      if (sira[i].href === duz(current)) index = i;
    }
    if (index === -1) return;

    // Yuklu rotalar: her birinin sinir isareti ve kendi bolumleri.
    function bolumleriTopla(kokler) {
      var cikti = [];
      kokler.forEach(function (k) {
        if (k.matches && k.matches('.ml-section, [data-parca]')) cikti.push(k);
        if (k.querySelectorAll) {
          Array.prototype.forEach.call(k.querySelectorAll('.ml-section, [data-parca]'), function (s) {
            cikti.push(s);
          });
        }
      });
      return cikti;
    }

    function teknikSay(kokler) {
      var toplam = 0;
      kokler.forEach(function (k) {
        if (k.classList && k.classList.contains('ml-technical')) toplam++;
        if (k.querySelectorAll) toplam += k.querySelectorAll('.ml-technical').length;
      });
      return toplam;
    }

    var ilkKokler = Array.prototype.slice.call(main.children);
    var bloklar = [
      {
        href: sira[index].href,
        label: sira[index].label,
        baslik: document.title,
        isaret: null,
        bolumler: bolumleriTopla(ilkKokler),
        teknik: teknikSay(ilkKokler),
      },
    ];

    var sonYuklenen = index;
    var ilkYuklenen = index;
    var yukleniyorAsagi = false;
    var yukleniyorYukari = false;
    var asagiBitti = index >= sira.length - 1;
    var yukariBitti = index <= 0;
    var sonEl = document.querySelector('[data-endless-son]');
    if (asagiBitti && sonEl) sonEl.hidden = false;

    var toast = document.querySelector('[data-chapter-toast]');
    var toastTimeout = null;
    function toastGoster(label) {
      if (!toast) return;
      toast.innerHTML = '<span class="ml-chapter-toast__icon">' + ikonBolum + '</span> <span>Bölüm: <strong>' + label + '</strong></span>';
      toast.setAttribute('data-acik', '');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(function () {
        toast.removeAttribute('data-acik');
      }, 2400);
    }

    function betikleriCalistir(kok) {
      Array.prototype.forEach.call(kok.querySelectorAll('script'), function (eski) {
        var yeni = document.createElement('script');
        Array.prototype.forEach.call(eski.attributes, function (a) {
          yeni.setAttribute(a.name, a.value);
        });
        yeni.text = eski.textContent;
        eski.parentNode.replaceChild(yeni, eski);
      });
    }

    function ayracOlustur(hedefLabel, hedefHref, yukariMi) {
      var isaret = document.createElement('div');
      isaret.className = 'ml-endless-ayrac rv';
      isaret.setAttribute('data-endless-rota', hedefHref);
      isaret.innerHTML =
        '<div class="ml-endless-ayrac__bar">' +
          '<span class="ml-endless-ayrac__pulse" aria-hidden="true"></span>' +
          '<span class="ml-endless-ayrac__badge">' + (yukariMi ? 'Önceki Bölüm' : 'Sonraki Bölüm') + '</span>' +
          '<div class="ml-endless-ayrac__line" aria-hidden="true"></div>' +
        '</div>' +
        '<div class="ml-endless-ayrac__header">' +
          '<h2 class="ml-endless-ayrac__title">' + hedefLabel + '</h2>' +
          '<span class="ml-endless-ayrac__hint">' + (yukariMi ? '↑ Yukarı Akış' : '↓ Aşağı Akış') + '</span>' +
        '</div>';
      return isaret;
    }

    function yukleAsagi() {
      if (yukleniyorAsagi || asagiBitti) return;
      var hedef = sira[sonYuklenen + 1];
      if (!hedef) {
        asagiBitti = true;
        return;
      }
      yukleniyorAsagi = true;

      fetch(hedef.href + '/')
        .then(function (y) {
          if (!y.ok) throw new Error('HTTP ' + y.status);
          return y.text();
        })
        .then(function (html) {
          var belge = new DOMParser().parseFromString(html, 'text/html');
          var kaynak = belge.getElementById('icerik');
          if (!kaynak) throw new Error('icerik yok');

          var isaret = ayracOlustur(hedef.label, hedef.href, false);
          main.appendChild(isaret);

          var eklenen = [];
          while (kaynak.firstChild) {
            var dugum = document.adoptNode(kaynak.firstChild);
            main.appendChild(dugum);
            if (dugum.nodeType === 1) eklenen.push(dugum);
          }

          eklenen.forEach(function (el) {
            betikleriCalistir(el);
            if (window.mlTerimTara) window.mlTerimTara(el);
          });
          if (window.mlRevealTara) window.mlRevealTara();

          bloklar.push({
            href: hedef.href,
            label: hedef.label,
            baslik: (belge.title || hedef.label).trim(),
            isaret: isaret,
            bolumler: bolumleriTopla(eklenen),
            teknik: teknikSay(eklenen),
          });

          sonYuklenen += 1;
          yukleniyorAsagi = false;
          if (sonYuklenen >= sira.length - 1) {
            asagiBitti = true;
            if (sonEl) sonEl.hidden = false;
          }
          olc();
        })
        .catch(function () {
          yukleniyorAsagi = false;
          asagiBitti = true;
        });
    }

    function yukleYukari() {
      if (yukleniyorYukari || yukariBitti) return;
      var hedef = sira[ilkYuklenen - 1];
      if (!hedef) {
        yukariBitti = true;
        return;
      }
      yukleniyorYukari = true;

      fetch(hedef.href + '/')
        .then(function (y) {
          if (!y.ok) throw new Error('HTTP ' + y.status);
          return y.text();
        })
        .then(function (html) {
          var belge = new DOMParser().parseFromString(html, 'text/html');
          var kaynak = belge.getElementById('icerik');
          if (!kaynak) throw new Error('icerik yok');

          var eskiScrollYukseklik = document.documentElement.scrollHeight;
          var eskiScrollY = window.scrollY;

          var frag = document.createDocumentFragment();

          var eklenen = [];
          while (kaynak.firstChild) {
            var dugum = document.adoptNode(kaynak.firstChild);
            frag.appendChild(dugum);
            if (dugum.nodeType === 1) eklenen.push(dugum);
          }

          var isaret = ayracOlustur(sira[ilkYuklenen].label, sira[ilkYuklenen].href, true);
          frag.appendChild(isaret);

          main.insertBefore(frag, main.firstChild);

          var yeniScrollYukseklik = document.documentElement.scrollHeight;
          var fark = yeniScrollYukseklik - eskiScrollYukseklik;
          window.scrollTo({ top: eskiScrollY + fark, behavior: 'instant' });

          eklenen.forEach(function (el) {
            betikleriCalistir(el);
            if (window.mlTerimTara) window.mlTerimTara(el);
          });
          if (window.mlRevealTara) window.mlRevealTara();

          bloklar.unshift({
            href: hedef.href,
            label: hedef.label,
            baslik: (belge.title || hedef.label).trim(),
            isaret: null,
            bolumler: bolumleriTopla(eklenen),
            teknik: teknikSay(eklenen),
          });

          if (bloklar[1]) {
            bloklar[1].isaret = isaret;
          }

          ilkYuklenen -= 1;
          yukleniyorYukari = false;
          if (ilkYuklenen <= 0) {
            yukariBitti = true;
          }
          olc();
        })
        .catch(function () {
          yukleniyorYukari = false;
          yukariBitti = true;
        });
    }

    var aktifHref = bloklar[0].href;

    function olc() {
      var esik = window.innerHeight * 0.3;
      var secili = bloklar[0];
      for (var i = 1; i < bloklar.length; i++) {
        if (bloklar[i].isaret && bloklar[i].isaret.getBoundingClientRect().top <= esik) {
          secili = bloklar[i];
        }
      }

      if (secili.href !== aktifHref) {
        var eskiHref = aktifHref;
        aktifHref = secili.href;
        if (window.mlRayRota) window.mlRayRota(secili.href, secili.bolumler);
        document.dispatchEvent(
          new CustomEvent('manipulens:rota-degisti', {
            detail: { href: secili.href, label: secili.label, teknik: secili.teknik },
          }),
        );
        document.title = secili.baslik;
        try {
          history.replaceState(null, '', secili.href + '/');
        } catch (e) {}

        if (eskiHref) {
          toastGoster(secili.label);
        }
      }

      var kalan =
        document.documentElement.scrollHeight - window.scrollY - window.innerHeight;
      if (kalan < window.innerHeight * 1.5) yukleAsagi();

      if (window.scrollY < window.innerHeight * 0.8 && !yukariBitti) yukleYukari();
    }

    window.addEventListener('scroll', olc, { passive: true });
    window.addEventListener('resize', olc, { passive: true });
    document.addEventListener('manipulens:mode-change', olc);
    olc();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mlSonsuzKur);
  } else {
    mlSonsuzKur();
  }
</script>

<style is:global>
  .ml-endless-ayrac {
    margin: clamp(3.5rem, 8vw, 5.5rem) 0 clamp(2rem, 4vw, 3rem);
    padding: 1.5rem 1.8rem;
    background: var(--ml-card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--ml-card-border);
    border-left: 5px solid var(--ml-scan);
    border-radius: var(--ml-radius);
    box-shadow: var(--ml-shadow-md);
    position: relative;
    overflow: hidden;
  }
  .ml-endless-ayrac::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--ml-scan), transparent 75%);
  }
  .ml-endless-ayrac__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .ml-endless-ayrac__pulse {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--ml-scan);
    box-shadow: 0 0 8px var(--ml-scan);
    animation: ml-lens-breath 3s infinite;
  }
  .ml-endless-ayrac__badge {
    font-family: var(--ml-font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-scan);
    background: var(--ml-scan-dim);
    padding: 0.2rem 0.55rem;
    border-radius: var(--ml-radius-sm);
  }
  .ml-endless-ayrac__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--ml-line-soft), transparent);
  }
  .ml-endless-ayrac__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .ml-endless-ayrac__title {
    margin: 0;
    font-family: var(--ml-font-display);
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    color: var(--ml-ink);
    line-height: 1.2;
    font-weight: 700;
  }
  .ml-endless-ayrac__hint {
    font-family: var(--ml-font-mono);
    font-size: 0.72rem;
    color: var(--ml-ink-muted);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .ml-chapter-toast {
    position: fixed;
    top: 4.8rem;
    left: 50%;
    transform: translateX(-50%) translateY(-1rem);
    z-index: 90;
    background: var(--ml-navy);
    color: #f5f7fb;
    font-family: var(--ml-font-body);
    font-size: 0.84rem;
    padding: 0.55rem 1.3rem;
    border: 1px solid rgba(35, 201, 214, 0.4);
    border-radius: 999px;
    box-shadow: var(--ml-shadow-lg);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ml-ease), transform 0.25s var(--ml-ease);
  }
  .ml-chapter-toast[data-acik] {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .ml-chapter-toast strong {
    color: #23c9d6;
  }
  .ml-chapter-toast__icon {
    font-size: 0.95rem;
  }

  .ml-endless-son {
    margin-block: 2.5rem 0;
    padding: 1.1rem 1.35rem;
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius);
    background: var(--ml-card-bg);
    box-shadow: var(--ml-shadow-sm);
  }
  .ml-endless-son p {
    margin: 0;
    font-family: var(--ml-font-mono);
    font-size: var(--ml-step--1);
    color: var(--ml-ink-muted);
    font-weight: 600;
  }
</style>
