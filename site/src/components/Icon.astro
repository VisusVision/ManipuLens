---
/**
 * Arayuz ikonlari - satir ici SVG, tek renk.
 *
 * Neden emoji degil: emoji isletim sisteminin renk paletiyle gelir; sitenin
 * krem/lacivert/turkuaz editoryal dili disinda durur, koyu temada uyum
 * saglamaz ve platformdan platforma bicim degistirir. Buradaki setin tamami
 * `currentColor` kullanir, Motif.astro ile ayni gorsel dili paylasir
 * (yuvarlak uc) ama arayuz olcegine gore daha ince cizilir.
 *
 * Motif.astro icerik gorseli tasir (64px spot), bu dosya kontrol yuzeyi
 * ikonlarini tasir (15-20px). Ikisini karistirma.
 *
 * Cizimler `src/lib/icons.ts` icinde; SearchModal ayni haritayi tarayicida
 * kullaniyor, bu yuzden kopya tutulmuyor.
 */
import { ICON_PATHS, ICON_FALLBACK } from '../lib/icons';

interface Props {
  ad: string;
  /** Ekran okuyucu icin; bos birakilirsa ikon dekoratif sayilir. */
  alt?: string;
  boyut?: number;
  class?: string;
}
const { ad, alt, boyut = 18, class: ekSinif = '' } = Astro.props;

const cizim = ICON_PATHS[ad] ?? ICON_PATHS[ICON_FALLBACK];
const dekoratif = !alt;
---
<svg
  class:list={['ml-icon', ekSinif]}
  width={boyut}
  height={boyut}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={dekoratif ? undefined : 'img'}
  aria-hidden={dekoratif ? 'true' : undefined}
  aria-label={alt}
  set:html={cizim}
/>

<style>
  .ml-icon {
    display: block;
    flex: none;
    color: inherit;
  }
</style>
