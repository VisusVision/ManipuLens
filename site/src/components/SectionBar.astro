---
/**
 * Dar ekranda sayfanin kendi bolumlerini gosteren serit.
 *
 * Masaustunde bu is yan raya ait: `SideRail` aktif rotanin altina ayni bolum
 * listesini numaralayarak basiyor ve kaydirdikca ilerletiyor. Serit orada ayni
 * listeyi ikinci kez basiyordu - iki yapiskan katman, tek bilgi. 60rem ustunde
 * serit kapali; ayni betik o genislikte basligin konum satirini (`data-crumb`)
 * besliyor, boylece okunan bolum tek satirda gorunur.
 *
 * 60rem altinda yan ray hic yok (`SideRail` display: none), sayfa ici gezinme
 * yalniz bu serittir - orada gorunur kalir.
 *
 * Basliklar sunucuda bilinmiyor - her sayfa Section bilesenini kendi kurguyla
 * cagiriyor - bu yuzden liste tarayicida `.ml-section` dugumlerinden
 * dolduruluyor. Betik calismazsa serit hic gorunmez; icerik etkilenmez.
 *
 * Sonsuz kaydirma yeni rota ekledikce liste tazeleniyor: `ml-section-bar:tazele`
 * olayini EndlessScroll gonderiyor.
 */
---
<div class="ml-section-bar" data-section-bar hidden>
  <div class="ml-shell ml-section-bar__inner">
    <span class="ml-section-bar__label" aria-hidden="true">Bu sayfada</span>
    <nav class="ml-section-bar__nav" aria-label="Sayfa bölümleri">
      <ul class="ml-section-bar__list" data-section-bar-list></ul>
    </nav>
  </div>
</div>

<script is:inline>
  (function () {
    var serit = document.querySelector('[data-section-bar]');
    var liste = document.querySelector('[data-section-bar-list]');
    if (!serit || !liste) return;

    /* Yan ray 60rem ustunde aciliyor. Ayni esik burada da gecerli: rayin oldugu
       yerde serit kapali, olmadigi yerde acik. */
    var genis = window.matchMedia('(min-width: 60.0625rem)');

    var kunye = document.querySelector('[data-crumb-section]');
    var kunyeGrup = document.querySelector('[data-crumb-group]');
    var kunyeSayfa = document.querySelector('[data-crumb-page]');

    var kayitlar = [];

    /* Yapiskan katman yuksekligi: serit basligin altina otursun, bir baslige
       atlandiginda hedef bu iki seridin arkasinda kalmasin. */
    function yukseklikleriOlc() {
      var kok = document.documentElement;
      var baslik = document.querySelector('.ml-header');
      var basY = baslik ? baslik.getBoundingClientRect().height : 0;
      kok.style.setProperty('--ml-header-h', basY + 'px');
      var seritY = serit.hidden ? 0 : serit.getBoundingClientRect().height;
      kok.style.setProperty('--ml-sticky-h', basY + seritY + 'px');
    }

    function baslikMetni(bolum) {
      var b = bolum.querySelector('.ml-section__title');
      return b ? (b.textContent || '').trim() : '';
    }

    /** Kimligi olmayan bolume tiklanabilmesi icin kararli bir kimlik ver. */
    function kimlikVer(bolum, sira) {
      if (bolum.id) return bolum.id;
      var yeni = 'bolum-' + sira;
      while (document.getElementById(yeni)) yeni += '-x';
      bolum.id = yeni;
      return yeni;
    }

    function doldur() {
      var bolumler = Array.prototype.slice.call(
        document.querySelectorAll('#icerik .ml-section'),
      );
      liste.textContent = '';
      kayitlar = [];

      bolumler.forEach(function (bolum, i) {
        var metin = baslikMetni(bolum);
        if (!metin) return;
        var id = kimlikVer(bolum, i + 1);

        var li = document.createElement('li');
        var a = document.createElement('a');
        a.className = 'ml-section-bar__link';
        a.href = '#' + id;
        a.textContent = metin;
        li.appendChild(a);
        liste.appendChild(li);
        kayitlar.push({ bolum: bolum, link: a, id: id, metin: metin });
      });

      // Tek baslik varsa serit bilgi tasimiyor; genis ekranda zaten yan ray var.
      serit.hidden = kayitlar.length < 2 || genis.matches;
      yukseklikleriOlc();
      isaretle();
    }

    /** Konum satirindaki sayfa ve grup adini yan raydan oku - tek kaynak ray. */
    function kunyeRotaTazele() {
      var ray = document.querySelector('.ml-side-rail');
      if (!ray || !kunyeSayfa) return;
      var aktifRota = ray.querySelector('.ml-side-rail__route[aria-current="page"]');
      if (!aktifRota) return;

      var etiket = aktifRota.querySelector('.ml-side-rail__label');
      if (etiket) kunyeSayfa.textContent = (etiket.textContent || '').trim();

      if (!kunyeGrup) return;
      // Grup basligi rayda ayri bir `li`; aktif rotadan geriye dogru en yakini.
      var kutu = aktifRota.parentElement;
      var grup = '';
      while (kutu) {
        kutu = kutu.previousElementSibling;
        if (kutu && kutu.classList.contains('ml-side-rail__cat')) {
          grup = (kutu.textContent || '').trim();
          break;
        }
      }
      kunyeGrup.textContent = grup;
      kunyeGrup.hidden = grup === '';
    }

    /** Ustten biraz asagisi "okunan yer" sayilir; baslik tam tepedeyken de secili kalsin. */
    function isaretle() {
      var esik = 140;
      var secili = null;
      for (var i = 0; i < kayitlar.length; i++) {
        if (kayitlar[i].bolum.getBoundingClientRect().top <= esik) secili = kayitlar[i];
      }
      if (!secili && kayitlar.length) secili = kayitlar[0];

      kayitlar.forEach(function (k) {
        var aktif = k === secili;
        k.link.classList.toggle('is-active', aktif);
        if (aktif) {
          k.link.setAttribute('aria-current', 'true');
        } else {
          k.link.removeAttribute('aria-current');
        }
      });

      // Serit kapaliyken de calisir: genis ekranda okunan bolum basliktaki
      // konum satirinda gorunur, dar ekranda serit zaten listeyi tasiyor.
      if (kunye) {
        // Bazi sayfalarda ilk bolumun basligi sayfa adiyla ayni ("Kod okuma >
        // Kod okuma"). Ayni metni iki kez yazmak konum bilgisi tasimaz.
        var sayfaAdi = kunyeSayfa ? (kunyeSayfa.textContent || '').trim().toLowerCase() : '';
        var ayni = secili && secili.metin.trim().toLowerCase() === sayfaAdi;
        if (secili && kayitlar.length > 1 && !ayni) {
          kunye.textContent = secili.metin;
          kunye.setAttribute('href', '#' + secili.id);
          kunye.hidden = false;
        } else {
          kunye.hidden = true;
        }
      }

      if (secili && !serit.hidden) kaydirGorunume(secili.link);
    }

    /** Serit yatay kayiyorsa secili baslik gorunur kalsin. */
    function kaydirGorunume(link) {
      var kutu = liste.parentElement;
      if (!kutu || kutu.scrollWidth <= kutu.clientWidth) return;
      var l = link.getBoundingClientRect();
      var k = kutu.getBoundingClientRect();
      if (l.left < k.left || l.right > k.right) {
        kutu.scrollLeft += l.left - k.left - k.width / 2 + l.width / 2;
      }
    }

    var bekliyor = false;
    function scrollda() {
      if (bekliyor) return;
      bekliyor = true;
      requestAnimationFrame(function () {
        bekliyor = false;
        isaretle();
      });
    }

    window.addEventListener('scroll', scrollda, { passive: true });
    window.addEventListener('resize', function () {
      yukseklikleriOlc();
      scrollda();
    }, { passive: true });
    document.addEventListener('ml-section-bar:tazele', function () {
      doldur();
      kunyeRotaTazele();
    });
    document.addEventListener('manipulens:rota-degisti', kunyeRotaTazele);

    genis.addEventListener('change', doldur);

    doldur();
  })();
</script>

<style>
  .ml-section-bar {
    position: sticky;
    /* Baslik da yapiskan; serit onun altina oturmali. Yukseklik betikte olculup
       --ml-header-h'e yaziliyor, olculemezse makul bir varsayilan kaliyor. */
    top: var(--ml-header-h, 3.6rem);
    z-index: 19;
    background: color-mix(in srgb, var(--ml-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--ml-line-soft);
  }
  .ml-section-bar[hidden] { display: none; }

  .ml-section-bar__inner {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 2.6rem;
  }

  .ml-section-bar__label {
    flex: none;
    font-family: var(--ml-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }

  /* Baslik sayisi ekrana sigmazsa serit yatay kayar, satir kirilmaz. */
  .ml-section-bar__nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ml-section-bar__nav::-webkit-scrollbar { display: none; }

  .ml-section-bar__list {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Liste ogeleri ve linkler betikte createElement ile basiliyor; Astro'nun
     kapsam ozniteligi yalniz sablondaki dugumlere gidiyor. Kapsamli yazilinca bu
     kurallar hicbir zaman tutmuyordu: link `display: inline` kalip serit icinde
     satir kiriyordu. Adlar zaten `ml-section-bar__` onekli, genel yazmak guvenli. */
  .ml-section-bar__list :global(li) { margin: 0; flex: none; }

  :global(.ml-section-bar__link) {
    display: block;
    white-space: nowrap;
    padding: 0.5rem 0.6rem;
    font-size: var(--ml-step--1);
    line-height: 1.2;
    color: var(--ml-ink-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color var(--ml-duration) var(--ml-ease),
                border-color var(--ml-duration) var(--ml-ease);
  }
  :global(.ml-section-bar__link:hover) { color: var(--ml-ink); }
  :global(.ml-section-bar__link.is-active) {
    color: var(--ml-scan);
    border-bottom-color: var(--ml-scan);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .ml-section-bar__label { display: none; }
  }
</style>
