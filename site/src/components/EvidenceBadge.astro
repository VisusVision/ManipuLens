---
/**
 * Kanit ve guncellik rozeti. Icerik hangi commit'te dogrulandi, kim sahibi,
 * yeniden dogrulama gerekiyor mu.
 */
interface Props {
  commit?: string;
  verifiedAt?: Date;
  owner?: string;
  needsReverify?: boolean;
}
const { commit, verifiedAt, owner, needsReverify = false } = Astro.props;
const tarih = verifiedAt?.toISOString().slice(0, 10);
const gorunenSahip = owner?.trim().toLocaleLowerCase('tr-TR') === 'todo' ? undefined : owner;
---
<p class:list={['ml-badge', needsReverify && 'ml-badge--stale']}>
  {needsReverify
    ? <strong>Yeniden doğrulama gerekli</strong>
    : <strong>Doğrulandı</strong>}
  {commit && <span> · commit <code>{commit.slice(0, 7)}</code></span>}
  {tarih && <span> · {tarih}</span>}
  {gorunenSahip && <span> · sahip: {gorunenSahip}</span>}
</p>

<style>
  .ml-badge {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    align-items: baseline;
    font-size: var(--ml-step--1);
    color: var(--ml-ink-muted);
    border-left: 3px solid var(--ml-ok);
    padding: 0.3rem 0.7rem;
    background: var(--ml-paper-warm);
  }
  .ml-badge--stale { border-left-color: var(--ml-warn); }
  .ml-badge strong { color: var(--ml-ink); }
</style>
