---
/**
 * Iki seviyeli anlatim sozlesmesinin tek blogu.
 * kind='technical' -> yalniz teknik modda gorunur.
 * kind='simple'    -> yalniz sade modda gorunur.
 * kind='both'      -> her zaman gorunur (varsayilan).
 */
interface Props {
  kind?: 'simple' | 'technical' | 'both';
  title?: string;
  /** Katmanin bulundugu baslik seviyesine gore h2/h3 secilir. */
  as?: 'h2' | 'h3';
  /** Uzun tablo ve mimari semalarda olcu sinirini kaldirir. */
  wide?: boolean;
  /** Sayfaya girerken yumusak gorunme hareketi. */
  reveal?: boolean;
}
const { kind = 'both', title, as = 'h3', wide = false, reveal = true } = Astro.props;
const cls = kind === 'technical' ? 'ml-technical' : kind === 'simple' ? 'ml-simple-only' : '';
const Heading = as;
---
<section class:list={['ml-layer', cls, kind === 'technical' && 'ml-dark', reveal && 'rv']}>
  {title && <Heading class="ml-layer__title">{title}</Heading>}
  <div class:list={['ml-prose', wide && 'ml-layer__wide']}><slot /></div>
</section>

<style>
  .ml-layer {
    background: var(--ml-card-bg);
    color: var(--ml-ink);
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius);
    box-shadow: var(--ml-shadow-sm);
    padding: 1.25rem 1.5rem;
    margin-block: 1.5rem;
  }
  .ml-layer__title {
    margin: 0 0 0.75rem;
    font-size: var(--ml-step-1);
  }
  .ml-layer.ml-dark {
    background: var(--ml-navy);
    color: #dfe6f2;
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: var(--ml-shadow-md);
  }
  .ml-layer.ml-dark .ml-layer__title {
    color: #ffffff;
  }
  .ml-layer.ml-dark p {
    color: #dfe6f2;
  }
  .ml-layer.ml-dark code {
    background: rgba(35, 201, 214, 0.15);
    color: #23c9d6;
    border: 1px solid rgba(35, 201, 214, 0.3);
  }
  .ml-layer__wide { max-width: none; }
</style>
