---
import '../styles/global.css';
import ModeToggle from '../components/ModeToggle.astro';
import TermLink from '../components/TermLink.astro';
import TechRail from '../components/TechRail.astro';
import SideRail from '../components/SideRail.astro';
import EndlessScroll from '../components/EndlessScroll.astro';
import ModeBanner from '../components/ModeBanner.astro';
import SearchModal from '../components/SearchModal.astro';
import FloatingControls from '../components/FloatingControls.astro';
import SectionBar from '../components/SectionBar.astro';

interface Props {
  title: string;
  description?: string;
  /** Otomatik sozluk terim baglamayi kapatir (sozluk sayfasinda gereksiz). */
  noTerms?: boolean;
}
const {
  title,
  description = 'ManipuLens yaşayan proje rehberi',
  noTerms = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav = [
  { href: `${base}/`, label: 'Başlangıç' },
  { href: `${base}/nasil-calisir`, label: 'Nasıl çalışır?' },
  { href: `${base}/sozluk`, label: 'Sözlük' },
  { href: `${base}/parcalar`, label: 'Parçalar' },
  { href: `${base}/ajanlar`, label: 'Ajan atlası' },
  { href: `${base}/kod`, label: 'Kod okuma' },
  { href: `${base}/dosyalar`, label: 'Depo haritası' },
  { href: `${base}/guncellemeler`, label: 'Güncellemeler' },
  { href: `${base}/kurulum`, label: 'Kurulum' },
  { href: `${base}/kararlar`, label: 'Kararlar' },
  { href: `${base}/gizlilik`, label: 'Gizlilik' },
  { href: `${base}/sss`, label: 'SSS' },
  { href: `${base}/yol-haritasi`, label: 'Yol haritası' },
  { href: `${base}/pano`, label: 'Pano' },
];
const navGroups = [
  { href: `${base}/`, label: 'Başlangıç' },
  { href: `${base}/nasil-calisir`, label: 'Nasıl çalışır?' },
  { href: `${base}/sozluk`, label: 'Sözlük' },
  {
    label: 'Mimari & Kod',
    items: [
      { href: `${base}/parcalar`, label: 'Parçalar' },
      { href: `${base}/ajanlar`, label: 'Ajan atlası' },
      { href: `${base}/kod`, label: 'Kod okuma' },
      { href: `${base}/dosyalar`, label: 'Depo haritası' },
      { href: `${base}/guncellemeler`, label: 'Güncellemeler' },
    ],
  },
  {
    label: 'Kılavuz & Belgeler',
    items: [
      { href: `${base}/kurulum`, label: 'Kurulum' },
      { href: `${base}/kararlar`, label: 'Kararlar' },
      { href: `${base}/gizlilik`, label: 'Gizlilik' },
      { href: `${base}/sss`, label: 'SSS' },
      { href: `${base}/yol-haritasi`, label: 'Yol haritası' },
    ],
  },
  { href: `${base}/pano`, label: 'Pano' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || base;
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '');
  return target === base
    ? current === base
    : current === target || current.startsWith(`${target}/`);
};

/**
 * Ust seritteki konum satiri. Masaustunde marka blogu gizleniyor (yan raydaki
 * marka ile birebir ayniydi, iki mercek + iki baslik yan yana duruyordu);
 * bosalan yere hangi grupta ve hangi sayfada oldugunu yazan satir geliyor.
 * Sunucuda hesaplaniyor ki betik calismasa da dogru dursun.
 */
const activeGroup =
  navGroups.find((g) => g.items?.some((i) => isCurrent(i.href)))?.label ?? null;
const activePage =
  [...nav].reverse().find((n) => isCurrent(n.href))?.label ?? title;

const isGroupActive = (items?: { href: string }[]) => {
  if (!items) return false;
  return items.some((item) => isCurrent(item.href));
};
---
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ManipuLens</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Anahtar secimini boyama oncesi uygula; yanip sonme olmasin.
      document.documentElement.classList.add('ml-js');
      try {
        document.documentElement.dataset.mlMode =
          localStorage.getItem('manipulens:mode') === 'teknik' ? 'teknik' : 'sade';
      } catch (e) {
        document.documentElement.dataset.mlMode = 'sade';
      }
    </script>
  </head>
  <body data-ml-no-terms={noTerms ? "" : undefined}>
    <a class="ml-skip" href="#icerik">İçeriğe geç</a>

    <SideRail nav={nav} current={current} base={base} />

    <div class="ml-app-page">

    <header class="ml-header">
      <div class="ml-shell ml-header__inner">
        <a class="ml-brand" href={`${base}/`}>
          <span class="ml-brand__lens" aria-hidden="true"></span>
          ManipuLens<span class="ml-brand__sub">rehber</span>
        </a>
        <div class="ml-crumb" data-crumb>
          {activeGroup && (
            <span class="ml-crumb__group" data-crumb-group>{activeGroup}</span>
          )}
          <span class="ml-crumb__page" data-crumb-page>{activePage}</span>
          <a class="ml-crumb__section" data-crumb-section href="#icerik" hidden></a>
        </div>
        <nav class="ml-nav" aria-label="Ana bölümler">
          <ul class="ml-nav__list">
            {navGroups.map((g) => (
              g.href ? (
                <li class="ml-nav__item">
                  <a
                    class="ml-nav__link"
                    href={g.href}
                    aria-current={isCurrent(g.href) ? 'page' : undefined}
                  >
                    {g.label}
                  </a>
                </li>
              ) : (
                <li class="ml-nav__item ml-nav__item--dropdown">
                  <details class="ml-dropdown">
                    <summary class:list={['ml-dropdown__summary', isGroupActive(g.items) && 'is-active']}>
                      <span>{g.label}</span>
                      <svg class="ml-dropdown__icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>
                    <ul class="ml-dropdown__menu">
                      {g.items?.map((item) => (
                        <li>
                          <a
                            class="ml-dropdown__link"
                            href={item.href}
                            aria-current={isCurrent(item.href) ? 'page' : undefined}
                          >
                            {item.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              )
            ))}
          </ul>
        </nav>
        <details class="ml-mobile-nav">
          <summary>Bölümler</summary>
          <nav aria-label="Mobil ana bölümler">
            <ul>
              {nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
        <div class="ml-header__actions">
          <SearchModal />
          <ModeToggle />
        </div>
      </div>
    </header>

    <SectionBar />

    <TechRail />

    <ModeBanner />

    <main id="icerik" class="ml-shell" tabindex="-1"><slot /></main>

    <EndlessScroll nav={nav} current={current} />

    <TermLink />

    <FloatingControls />

    <script is:inline>
      // Scroll reveal - sifir bagimlilik. Hareket azaltma acikken hic calismaz.
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var destek = 'IntersectionObserver' in window;
        var io = destek && !reduce
          ? new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('rv--in');
                  io.unobserve(e.target);
                }
              });
            }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 })
          : null;

        function tara() {
          document.querySelectorAll('.rv:not(.rv--in)').forEach(function (el) {
            if (getComputedStyle(el).display === 'none') return;
            if (!io) el.classList.add('rv--in');
            else io.observe(el);
          });
        }

        /**
         * Guvenlik agi: gorunum animasyonu icerigi gizliyor, aciyor olan
         * IntersectionObserver. Gozlemci gizli belgede (arka plan sekmesi,
         * on izleme paneli, bazi gomulu gorunumler) hicbir kayit teslim etmez;
         * o durumda sayfa bos krem bir yuzey olarak kalir. Bu yuzden hem
         * belge gorunur olunca yeniden taraniyor hem de kisa bir sure sonra
         * ekranda olan ne varsa geometriye bakip aciliyor.
         */
        function ekrandakileriAc() {
          document.querySelectorAll('.rv:not(.rv--in)').forEach(function (el) {
            var k = el.getBoundingClientRect();
            if (k.height === 0) return;
            if (k.top < window.innerHeight && k.bottom > 0) el.classList.add('rv--in');
          });
        }

        tara();
        setTimeout(ekrandakileriAc, 1200);
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState !== 'visible') return;
          tara();
          requestAnimationFrame(ekrandakileriAc);
        });
        // Sade modda gizli teknik bloklar geometri tasimaz. Mod acilinca yeniden tara.
        document.addEventListener('manipulens:mode-change', function () {
          requestAnimationFrame(tara);
        });
        // Sonsuz kaydirma alta yeni rota ekliyor; o blok da taranmali.
        window.mlRevealTara = tara;
      })();
    </script>

    <footer class="ml-footer ml-dark">
      <div class="ml-shell">
        <p>
          ManipuLens · <a href="https://github.com/VisusVision/ManipuLens">VisusVision/ManipuLens</a>
        </p>
        <p class="ml-footer__note">
          Bu rehberin kaynak doğrusu çalışan koddur. Her sayfa hangi commit'te doğrulandığını gösterir.
        </p>
      </div>
    </footer>
    </div>
  </body>
</html>

<style>
  .ml-app-page { min-width: 0; }
  @media (min-width: 60.0625rem) {
    .ml-app-page { margin-left: 15.5rem; }
  }
  .ml-header {
    border-bottom: 1px solid var(--ml-line-soft);
    background: var(--ml-paper);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 20;
    transition: border-color var(--ml-duration) ease;
  }
  .ml-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block: 0.75rem;
  }
  .ml-header__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }
  .ml-brand {
    font-family: var(--ml-font-display);
    font-size: var(--ml-step-1);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .ml-brand__lens {
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--ml-ink);
    border-radius: 50%;
    box-shadow: inset 0 0 0 3px var(--ml-scan-dim);
    transition: transform var(--ml-duration) var(--ml-ease);
  }
  .ml-brand:hover .ml-brand__lens {
    transform: scale(1.1);
  }
  .ml-brand__sub {
    font-family: var(--ml-font-mono);
    font-size: 0.52em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-scan);
    font-weight: 700;
    padding: 0.15em 0.45em;
    background: var(--ml-scan-dim);
    border-radius: var(--ml-radius-sm);
    margin-left: 0.25rem;
  }

  /* Konum satiri: masaustunde markanin yerini alir. Dar ekranda yan ray yok,
     orada marka gorunur ve bu satir gizlenir - iki yuzey ayni anda kimlik
     tasimaz. */
  .ml-crumb {
    display: none;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
    flex: 1;
  }
  .ml-crumb__group {
    flex: none;
    font-family: var(--ml-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  .ml-crumb__group::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--ml-line-soft);
  }
  .ml-crumb__page {
    flex: none;
    font-family: var(--ml-font-display);
    font-size: var(--ml-step-0);
    font-weight: 700;
    color: var(--ml-ink);
  }
  .ml-crumb__section {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--ml-font-mono);
    font-size: var(--ml-step--1);
    color: var(--ml-scan);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--ml-duration) var(--ml-ease);
  }
  .ml-crumb__section[hidden] { display: none; }
  .ml-crumb__section::before {
    content: '›';
    margin-right: 0.5rem;
    color: var(--ml-line-soft);
  }
  .ml-crumb__section:hover { border-bottom-color: var(--ml-scan); }

  .ml-nav { display: flex; align-items: center; }
  .ml-mobile-nav { display: none; }
  .ml-nav__list {
    display: flex;
    align-items: center;
    gap: 0.4rem 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--ml-step--1);
  }
  .ml-nav__item { position: relative; }
  .ml-nav__link {
    text-decoration: none;
    padding: 0.4rem 0.65rem;
    border-radius: var(--ml-radius-sm);
    color: var(--ml-ink-muted);
    font-weight: 600;
    transition: color var(--ml-duration) var(--ml-ease), background var(--ml-duration) var(--ml-ease);
    display: inline-block;
  }
  .ml-nav__link:hover {
    color: var(--ml-ink);
    background: var(--ml-paper-warm);
  }
  .ml-nav__link[aria-current='page'] {
    color: var(--ml-scan);
    background: var(--ml-scan-dim);
    font-weight: 700;
  }

  /* Dropdown Menus */
  .ml-dropdown { position: relative; }
  .ml-dropdown__summary {
    list-style: none;
    cursor: pointer;
    padding: 0.4rem 0.65rem;
    border-radius: var(--ml-radius-sm);
    color: var(--ml-ink-muted);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color var(--ml-duration) var(--ml-ease), background var(--ml-duration) var(--ml-ease);
    user-select: none;
  }
  .ml-dropdown__summary::-webkit-details-marker { display: none; }
  .ml-dropdown__summary:hover,
  .ml-dropdown[open] .ml-dropdown__summary {
    color: var(--ml-ink);
    background: var(--ml-paper-warm);
  }
  .ml-dropdown__summary.is-active {
    color: var(--ml-scan);
    font-weight: 700;
  }
  .ml-dropdown__icon {
    transition: transform var(--ml-duration) var(--ml-ease);
  }
  .ml-dropdown[open] .ml-dropdown__icon {
    transform: rotate(180deg);
  }
  .ml-dropdown__menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 11.5rem;
    background: var(--ml-paper);
    border: 1px solid var(--ml-line-soft);
    border-radius: var(--ml-radius);
    box-shadow: var(--ml-shadow-md);
    padding: 0.4rem;
    list-style: none;
    margin: 0;
    z-index: 50;
  }
  .ml-dropdown__link {
    display: block;
    padding: 0.4rem 0.75rem;
    border-radius: var(--ml-radius-sm);
    color: var(--ml-ink-muted);
    text-decoration: none;
    font-size: var(--ml-step--1);
    font-weight: 550;
    transition: background var(--ml-duration) var(--ml-ease), color var(--ml-duration) var(--ml-ease);
  }
  .ml-dropdown__link:hover {
    background: var(--ml-paper-warm);
    color: var(--ml-ink);
  }
  .ml-dropdown__link[aria-current='page'] {
    background: var(--ml-scan-dim);
    color: var(--ml-scan);
    font-weight: 700;
  }

  @media (min-width: 60.0625rem) {
    .ml-header nav { display: none; }
    /* Yan ray zaten mercek + ManipuLens + alt basligi tasiyor; ustte ikinci
       kopyasi duruyordu. Kimlik tek yerde kalir, ust serit konuma ayrilir. */
    .ml-brand { display: none; }
    .ml-crumb { display: flex; }
  }
  @media (max-width: 60rem) {
    .ml-header__inner {
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-block: 0.6rem;
    }
    .ml-nav {
      display: none;
    }
    .ml-mobile-nav {
      display: block;
      width: 100%;
      order: 3;
    }
    .ml-mobile-nav summary {
      cursor: pointer;
      list-style: none;
      padding: 0.4rem 0.65rem;
      border: 1px solid var(--ml-line-soft);
      border-radius: var(--ml-radius-sm);
      color: var(--ml-ink-muted);
      font-size: var(--ml-step--1);
      font-weight: 700;
    }
    .ml-mobile-nav summary::-webkit-details-marker { display: none; }
    .ml-mobile-nav summary::after { content: '＋'; float: right; color: var(--ml-scan); }
    .ml-mobile-nav[open] summary::after { content: '−'; }
    .ml-mobile-nav ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.25rem;
      margin: 0.4rem 0 0;
      padding: 0.4rem;
      list-style: none;
      border: 1px solid var(--ml-line-soft);
      border-radius: var(--ml-radius);
      background: var(--ml-paper);
      box-shadow: var(--ml-shadow);
    }
    .ml-mobile-nav a {
      display: block;
      min-width: 0;
      padding: 0.42rem 0.5rem;
      border-radius: var(--ml-radius-sm);
      color: var(--ml-ink-muted);
      font-size: 0.78rem;
      font-weight: 600;
      line-height: 1.25;
      text-decoration: none;
    }
    .ml-mobile-nav a[aria-current='page'] {
      background: var(--ml-scan-dim);
      color: var(--ml-scan);
    }
  }

  main { padding-block: clamp(2rem, 6vw, 4.5rem); }
  .ml-footer {
    background: var(--ml-navy);
    color: var(--ml-ink);
    border-top: 3px solid var(--ml-scan);
    padding-block: 2.5rem;
    font-size: var(--ml-step--1);
  }
  .ml-footer__note { color: var(--ml-ink-muted); max-width: var(--ml-measure); }
</style>
