    "            \"temperature\": 0.2,",
    "            \"top_p\": 0.9",
    "        }",
    "    });",
    "",
    "    let response = http_client()",
    "        .post(format!(\"{}/api/generate\", ollama_url()))",
    "        .json(&payload)",
