  "satirlar": [
    "const buildFlexibleRegex = (sentence) => {",
    "  const cleaned = (sentence || \"\")",
    "    .trim()",
    "    .replace(/^[\"'‘’“”\\s]+/, \"\")",
    "    .replace(/[\"'‘’“”.…\\s]+$/, \"\");",
    "  if (cleaned.length < 5) return null;",
    "  const pattern = cleaned",
    "    .replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\")",
    "    .replace(/\\s+/g, \"[\\\\s\\\\u00A0]+\");",
    "  try {",
    "    return new RegExp(pattern, \"iu\");",
    "  } catch (e) {",
    "    return null;",
    "  }",
    "};"
  ],
