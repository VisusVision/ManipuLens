---
import Base from '../../layouts/Base.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import AgentTechnical from '../../components/AgentTechnical.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const ajanlar = await getCollection('ajanlar');
  return ajanlar.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.kisaca}>
  <article class="rv" style={`--agent: ${entry.data.color}`}>
    <p class="ml-agent-tag">
      <span aria-hidden="true"></span>
      <code>manipulation_type: "{entry.data.manipulation_type}"</code>
    </p>
    <h1>{entry.data.title}</h1>
    <EvidenceBadge
      commit={entry.data.verified_at_commit}
      verifiedAt={entry.data.verified_at}
      owner={entry.data.owner}
      needsReverify={entry.data.needs_reverify}
    />
    <div class="ml-prose ml-simple-only"><Content /></div>

    <AgentTechnical
      title={entry.data.title}
      manipulationType={entry.data.manipulation_type}
      sourceFn={entry.data.source_fn}
      odaklar={entry.data.teknik_odak}
      promptKarari={entry.data.prompt_karari}
      yanlisPozitif={entry.data.yanlis_pozitif}
    />
  </article>
</Base>

<style>
  .ml-agent-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--ml-step--1);
    color: var(--ml-ink-muted);
  }
  .ml-agent-tag span {
    width: 1rem; height: 1rem; border-radius: 50%;
    background: var(--agent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--agent) 22%, transparent);
  }
  article { border-left: 6px solid var(--agent); padding-left: clamp(0.8rem, 3vw, 1.5rem); }
</style>
