---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import CodeWalk from '../../components/CodeWalk.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const parcalar = (await getCollection('parcalar')).sort((a, b) => a.data.order - b.data.order);
  return parcalar.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      onceki: i > 0 ? parcalar[i - 1] : null,
      sonraki: i < parcalar.length - 1 ? parcalar[i + 1] : null,
    },
  }));
}

const { entry, onceki, sonraki } = Astro.props;
const { Content } = await render(entry);

// Bu parcaya ait kod okumalari - teknik modda acilir.
const kodlar = (await getCollection('kod'))
  .filter((k) => k.data.parca === entry.id)
  .sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={entry.data.title} description={entry.data.kisaca}>
  <Section
    as="h1"
    num={String(entry.data.order).padStart(2, '0')}
    kicker="Parçalar"
    title={entry.data.title}
    lede={entry.data.kisaca}
  >
    <EvidenceBadge
      commit={entry.data.verified_at_commit}
      verifiedAt={entry.data.verified_at}
      owner={entry.data.owner}
      needsReverify={entry.data.needs_reverify}
    />

    <dl class="ml-kunye">
      <div>
        <dt>Sorumluluk</dt>
        <dd>{entry.data.sorumluluk}</dd>
      </div>
      <div class="ml-technical">
        <dt>Dosyalar</dt>
        <dd><code>{entry.data.dosyalar}</code></dd>
      </div>
    </dl>

    <article class="ml-prose ml-parca-govde">
      <Content />
    </article>

    {kodlar.length > 0 && (
      <div class="ml-technical ml-parca-kod">
        <h2>Kod okuma</h2>
        <p class="ml-prose">
          Bu parçanın kritik bölümleri, gerçek kaynaktan kesilerek. Her biri üç soruyu
          cevaplıyor: ne yapıyor, neden böyle, kaldırırsak ne olur.
        </p>
        {kodlar.map((k) => (
          <CodeWalk
            id={k.id}
            baslik={k.data.title}
            dosya={k.data.dosya}
            dil={k.data.dil}
            neYapiyor={k.data.ne_yapiyor}
            nedenBoyle={k.data.neden_boyle}
            kaldirirsak={k.data.kaldirirsak}
            notlar={k.data.notlar}
            sina={k.data.sina}
            zorluk={k.data.zorluk}
          />
        ))}
      </div>
    )}

    <nav class="ml-komsu" aria-label="Diğer parçalar">
      {onceki ? (
        <a href={`${base}/parcalar/${onceki.id}`} class="ml-komsu__onceki">
          <span>Önceki parça</span>
          <strong>{onceki.data.title}</strong>
        </a>
      ) : (
        <a href={`${base}/parcalar`} class="ml-komsu__onceki">
          <span>Geri</span>
          <strong>Bütün parçalar</strong>
        </a>
      )}
      {sonraki && (
        <a href={`${base}/parcalar/${sonraki.id}`} class="ml-komsu__sonraki">
          <span>Sonraki parça</span>
          <strong>{sonraki.data.title}</strong>
        </a>
      )}
    </nav>
  </Section>
</Base>

<style>
  .ml-kunye {
    margin: 1.25rem 0 1.75rem;
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    background: var(--ml-paper-warm);
    border-left: 4px solid var(--ml-scan);
    border-radius: var(--ml-radius);
  }
  .ml-kunye dt {
    font-family: var(--ml-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  .ml-kunye dd { margin: 0.15rem 0 0; }
  .ml-kunye code { word-break: break-word; }

  /* Markdown govdesi: baslik hiyerarsisi ve tablolar. */
  .ml-parca-govde :global(h2) {
    margin: 2rem 0 0.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--ml-line-soft);
  }
  .ml-parca-govde :global(h3) { margin: 1.5rem 0 0.5rem; }
  .ml-parca-govde :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: var(--ml-step--1);
  }
  .ml-parca-govde :global(th),
  .ml-parca-govde :global(td) {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--ml-line-soft);
    vertical-align: top;
  }
  .ml-parca-govde :global(th) {
    font-family: var(--ml-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  /* Genis tablo ve kod sayfayi degil kendini kaydirir. */
  .ml-parca-govde :global(pre) { overflow-x: auto; }
  .ml-parca-govde { overflow-x: auto; }

  .ml-parca-kod { margin-top: 2.5rem; }
  .ml-parca-kod > h2 { margin-bottom: 0.4rem; }
  .ml-komsu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ml-line);
  }
  .ml-komsu a {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 1rem;
    text-decoration: none;
    border: 2px solid var(--ml-line-soft);
    border-radius: var(--ml-radius);
    min-width: 12rem;
  }
  .ml-komsu a:hover { border-color: var(--ml-line); box-shadow: var(--ml-shadow); }
  .ml-komsu__sonraki { text-align: right; margin-left: auto; }
  .ml-komsu span {
    font-family: var(--ml-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
</style>
