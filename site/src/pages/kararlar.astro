---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import Layer from '../components/Layer.astro';

/** Her karar: ne seçildi, ne elendi, neden. Gerekçesi olmayan karar bu listeye girmez. */
const kararlar = [
  {
    no: '01',
    baslik: 'Arka uç Rust ile yazıldı',
    secilen: 'Rust + Axum + Tokio',
    elenen: 'Python (FastAPI), Node.js (Express)',
    gerekce:
      'Altı ajanı paralel çalıştırmak asenkron bir çalışma zamanı istiyor ve Tokio bunu maliyetsiz veriyor. Python daha hızlı yazılırdı ama proje aynı zamanda bir öğrenme aracı; belleği ve eşzamanlılığı görünür kılan bir dil bilinçli tercih.',
    bedel:
      'Derleme süresi uzun, ekipte Rust bilen sayısı az. Küçük değişikliklerin maliyeti yüksek.',
  },
  {
    no: '02',
    baslik: 'Model yerelde çalışıyor, bulut yedeği yok',
    secilen: 'Ollama + llama3, tamamen yerel',
    elenen: 'OpenAI/Anthropic API, hibrit (yerel başarısızsa buluta düş)',
    gerekce:
      'Ürünün tek iddiası “metniniz makinenizden çıkmıyor”. Hibrit model bu iddiayı sessizce çürütürdü: kullanıcı hangi durumda metninin nereye gittiğini bilemezdi. İddiayı korumanın tek yolu yedeği hiç koymamak.',
    bedel:
      'Analiz yavaş ve donanıma bağlı. Ollama kapalıysa sistem hiç çalışmıyor. Model kalitesi bulut modellerinin gerisinde.',
  },
  {
    no: '03',
    baslik: 'Tek büyük prompt yerine altı ayrı ajan',
    secilen: 'Altı uzman ajan + bir sentezör (yedi model çağrısı)',
    elenen: 'Tek promptta altı analizi birden istemek',
    gerekce:
      'Tek prompt altı şeyi aynı anda sorunca model hepsini yüzeysel yapıyor. Ayrı ajanların her biri tek soruya odaklanıyor, çıktı şeması dar kalıyor ve JSON bozulma ihtimali düşüyor. Ayrıca bir ajanın çökmesi diğerlerini etkilemiyor.',
    bedel:
      'Analiz başına yedi model çağrısı. Bu maliyet doğrudan hız limitinin var olma sebebi.',
  },
  {
    no: '04',
    baslik: 'Uzantı Manifest V3 ile yazıldı',
    secilen: 'Manifest V3, service worker',
    elenen: 'Manifest V2',
    gerekce:
      'Chrome Web Store artık V2 kabul etmiyor. Seçim değil, zorunluluk.',
    bedel:
      'Kalıcı arka plan sayfası yok. Durum `chrome.storage` üzerinden taşınmak zorunda; bu da kodun bir kısmını gereğinden karmaşık yapıyor.',
  },
  {
    no: '05',
    baslik: 'Veri SQLite üzerinde',
    secilen: 'SQLite (rusqlite, bundled), WAL modu',
    elenen: 'PostgreSQL, JSON dosyaları',
    gerekce:
      'Tek kullanıcılı yerel bir araç için ayrı veritabanı sunucusu kurulumu zorlaştırırdı; kurulum adımı ne kadar azsa proje o kadar deneniyor. JSON dosyaları ise eşzamanlı yazmada bozuluyordu — nitekim eski sistem tam olarak öyleydi ve tek seferlik bir içe aktarımla terk edildi.',
    bedel:
      'Çok kullanıcılı bir senaryoya geçilirse taşınması gerekir. Veritabanı şifreli değil.',
  },
  {
    no: '06',
    baslik: 'Analiz ucu kimlik istiyor',
    secilen: 'Bearer token zorunlu + kullanıcı başına hız limiti',
    elenen: 'Açık uç (ilk hâli), IP başına limit',
    gerekce:
      'Kod yorumu durumu açıkça anlatıyor: uç eskiden tamamen açıktı, adresi bilen herkes sınırsız analiz tetikleyebiliyordu. Her analiz yedi model çağrısı demek. IP başına limit ise aynı makinedeki farklı kullanıcıları ayırt edemezdi.',
    bedel:
      'Kullanmak için hesap açmak gerekiyor. Tamamen yerel çalışan bir araç için bu sürtünme yaratıyor.',
  },
  {
    no: '07',
    baslik: 'Metnin tamamı saklanmıyor',
    secilen: '120 karakterlik önizleme + uzunluk',
    elenen: 'Tam metin saklama, hiç saklamama',
    gerekce:
      'Geçmiş listesinde kaydı tanımak için önizleme yetiyor. Hiç saklamamak geçmiş özelliğini imkânsız kılardı; tam metin ise fayda getirmeden risk eklerdi.',
    bedel:
      'Geçmişten eski bir analizi tam metniyle yeniden çalıştırmak mümkün değil.',
  },
  {
    no: '08',
    baslik: 'Rehber sitesi Astro ile, tek HTML dosyasıyla değil',
    secilen: 'Astro 5, içerik koleksiyonları, statik çıktı',
    elenen: 'Tek `index.html` (referans sitenin yaptığı gibi)',
    gerekce:
      'Referans site tek bölümlük bir sunum; bu rehber ise büyüyen çok sayfalı bir bilgi tabanı. Tek dosya birden fazla kişinin paralel yazmasını imkânsız kılar. İçerik Markdown dosyalarında ve şema doğrulamalı olunca kod yazmayan biri de düzenleyebiliyor.',
    bedel:
      '`npm install` ve derleme adımı gerekiyor; referans sitenin “çift tıkla açılır” sadeliği kayboldu.',
  },
  {
    no: '09',
    baslik: 'Trello panosu derleme zamanında çekiliyor',
    secilen: 'GitHub Actions ile çekim, `pano.json` depoya commit',
    elenen: 'Tarayıcıdan doğrudan Trello API çağrısı',
    gerekce:
      'Trello API anahtarı tarayıcıya konursa herkes görür ve token yazma yetkisi de taşır. Site statik olduğu için sırrı saklayacak bir sunucu da yok. Derleme zamanı çekimde anahtar GitHub Secrets içinde kalıyor, dışarı yalnız temizlenmiş JSON çıkıyor.',
    bedel:
      'Pano canlı değil; tazelik zamanlayıcıya bağlı. Sayfa bu yüzden “son çekim” damgası taşıyor.',
  },
];
---
<Base
  title="Mimari kararlar"
  description="Neden Rust, neden yerel model, neden altı ajan — seçilen, elenen ve gerekçesiyle."
>
  <Section
    as="h1"
    num="00"
    kicker="Neden böyle"
    title="Mimari kararlar"
    lede="Her karar üç parça taşır: ne seçildi, ne elendi, neden. Dördüncü bir alan daha var — bedeli. Bedeli yazılmamış karar, henüz anlaşılmamış karardır."
  >
    <EvidenceBadge owner="TODO" needsReverify={true} />
    <p class="ml-prose">
      Bu liste kararları savunmak için değil, hatırlamak için var. Altı ay sonra “neden böyle
      yapmışız” sorusunun cevabı burada durur; koşullar değişirse karar da değiştirilebilir.
    </p>
  </Section>

  {kararlar.map((k) => (
    <Section num={k.no} kicker="Karar" title={k.baslik}>
      <dl class="ml-karar">
        <div><dt>Seçilen</dt><dd>{k.secilen}</dd></div>
        <div><dt>Elenen</dt><dd>{k.elenen}</dd></div>
        <div><dt>Gerekçe</dt><dd>{k.gerekce}</dd></div>
        <div class="ml-karar__bedel"><dt>Bedeli</dt><dd>{k.bedel}</dd></div>
      </dl>
    </Section>
  ))}

  <Section
    num="10"
    kicker="Kanıt"
    title="Kararların koddaki izi"
    lede="Bir karar ancak kodda bir ize dönüşmüşse gerçekten alınmıştır. Sade katman kararı anlatır; teknik katman onu doğrulayan satırı gösterir."
  >
    <Layer kind="simple">
      <p>
        Yukarıdaki dokuz kararın hepsinin çalışan kodda karşılığı var: seçilen dil, seçilen
        model, ajan sayısı, veritabanı ve gizlilik sınırları. Teknik ayrıntı düğmesine
        basarsan her kararın hangi dosyada, hangi sabitle sabitlendiğini görürsün.
      </p>
    </Layer>

    <Layer kind="technical" title="Karar → kod kanıtı" wide>
      <table class="ml-kanit">
        <thead>
          <tr><th>Karar</th><th>Kodda görünen iz</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Rust + Axum</td>
            <td><code>Cargo.toml</code>: <code>axum 0.7</code>, <code>tokio 1 (full)</code>, <code>edition 2021</code></td>
          </tr>
          <tr>
            <td>Yerel model, bulut yedeği yok</td>
            <td><code>agents.rs</code>: <code>OLLAMA_URL</code> yoksa <code>http://localhost:11434</code>; gövde <code>"model": "llama3"</code>, <code>"format": "json"</code>, <code>temperature 0.2</code>. Bulut istemcisi hiç yok.</td>
          </tr>
          <tr>
            <td>Altı ayrı ajan</td>
            <td><code>orchestrator.rs</code>: altı çağrı paralel, her biri kendi <code>fallback("Dilsel" … "Pazarlama")</code> değerine düşüyor — bir ajanın hatası diğerlerini durdurmuyor.</td>
          </tr>
          <tr>
            <td>Manifest V3</td>
            <td><code>extension/manifest.json</code>: <code>"manifest_version": 3</code>, izinler <code>contextMenus, scripting, activeTab, storage</code>.</td>
          </tr>
          <tr>
            <td>SQLite</td>
            <td><code>Cargo.toml</code>: <code>rusqlite 0.31 (bundled)</code> — ayrı veritabanı sunucusu kurulmuyor, kütüphane derlemenin içinde geliyor.</td>
          </tr>
          <tr>
            <td>Kimlik + hız limiti</td>
            <td><code>auth.rs</code>: <code>ANALYZE_MAX_PER_WINDOW = 10</code> / <code>ANALYZE_WINDOW_SECS = 60</code>, <code>LOGIN_MAX_FAILS = 8</code>, <code>LOGIN_LOCK_SECS = 900</code>, <code>SESSION_TTL_SECS = 30 gün</code>.</td>
          </tr>
          <tr>
            <td>Metnin tamamı saklanmıyor</td>
            <td><code>audit.rs</code>: <code>PREVIEW_CHARS = 120</code>; <code>main.rs</code>: <code>HISTORY_LIMIT = 200</code>, <code>MAX_TEXT_LEN = 1000</code>.</td>
          </tr>
        </tbody>
      </table>
      <p>
        Bu tablo elle güncel tutuluyor; sayılar değişirse <code>npm run kod:kontrol</code> kod
        okuma katmanında uyumsuzluğu yakalar, bu tabloyu ise kimse yakalamaz. Bir sabiti
        değiştirirken buraya da bakılmalı.
      </p>
    </Layer>
  </Section>
</Base>

<style>
  .ml-kanit { width: 100%; border-collapse: collapse; font-size: var(--ml-step--1); }
  .ml-kanit th, .ml-kanit td {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--ml-line-soft);
  }
  .ml-kanit th { font-family: var(--ml-font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .ml-kanit td:first-child { width: 14rem; font-weight: 650; }

  .ml-karar { margin: 0; display: grid; gap: 0.75rem; }
  .ml-karar div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.3rem 1.2rem;
  }
  @media (max-width: 40rem) {
    .ml-karar div { grid-template-columns: 1fr; }
  }
  .ml-karar dt {
    font-family: var(--ml-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
    padding-top: 0.2rem;
  }
  .ml-karar dd { margin: 0; max-width: var(--ml-measure); }
  .ml-karar__bedel {
    border-left: 3px solid var(--ml-warn);
    padding-left: 0.8rem;
    margin-left: -0.8rem;
  }
</style>
