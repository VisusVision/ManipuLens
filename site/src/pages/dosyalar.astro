];

const moduller = [
  { id: 'hepsi', etiket: 'Tüm Dosyalar', sayi: dosyalar.length },
  { id: 'backend', etiket: 'Rust Backend (src/)', sayi: dosyalar.filter(d => d.modul === 'backend').length },
  { id: 'extension', etiket: 'Chrome Uzantısı (extension/)', sayi: dosyalar.filter(d => d.modul === 'extension').length },
  { id: 'config', etiket: 'Konfigürasyon & Docker', sayi: dosyalar.filter(d => d.modul === 'config').length },
];
---

<Base
  title="Depo Haritası & Dosya Rehberi"
  description="GitHub deposundaki tüm dosyaların görevi, içeriği, kritikliği ve kaldırıldığında ne olacağı."
>
  <Section
    as="h1"
    num="00"
    kicker="Kod Tabanı Kataloğu"
    title="Depo Haritası & Dosya Rehberi"
    lede="ManipuLens GitHub deposundaki her dosyanın neden var olduğunu, ne iş yaptığını, hangi işlevleri barındırdığını ve kaldırılırsa ne olacağını tek bir interaktif tabloda inceleyin."
  >
    <div class="ml-filemap-stats">
      <div class="ml-filemap-stat">
        <span class="ml-filemap-stat__num">{dosyalar.length}</span>
        <span class="ml-filemap-stat__label">Kataloglanan Dosya</span>
      </div>
      <div class="ml-filemap-stat">
        <span class="ml-filemap-stat__num">8</span>
        <span class="ml-filemap-stat__label">Rust Kaynak Modülü</span>
      </div>
      <div class="ml-filemap-stat">
        <span class="ml-filemap-stat__num">4</span>
        <span class="ml-filemap-stat__label">Eklenti Dosyası</span>
      </div>
      <div class="ml-filemap-stat">
        <span class="ml-filemap-stat__num">6</span>
        <span class="ml-filemap-stat__label">Kod Okuma Bağlantısı</span>
      </div>
    </div>
  </Section>

  <Section
    as="h2"
    num="01"
    kicker="Filtreleme & Arama"
    title="Depo Dosyalarını İnceleyin"
    lede="Modüle göre filtreleyin ya da arama kutusuna dosya adı, fonksiyon veya anahtar kelime yazarak arayın."
  >
    <!-- Filtre Çubuğu -->
    <div class="ml-filemap-filterbar">
      <div class="ml-filemap-tabs" role="tablist" aria-label="Modül filtreleri">
        {moduller.map((m, idx) => (
          <button
            type="button"
            class:list={['ml-filemap-tab', idx === 0 && 'is-active']}
            data-file-filter={m.id}
          >
            <span>{m.etiket}</span>
            <span class="ml-filemap-tab__badge">{m.sayi}</span>
          </button>
        ))}
      </div>

      <div class="ml-filemap-search">
        <span class="ml-filemap-search__icon" aria-hidden="true">🔍</span>
        <input
          type="search"
          class="ml-filemap-search__input"
          data-file-search
          placeholder="Dosya adı, fonksiyon veya görev ara..."
          aria-label="Dosya ara"
        />
      </div>
    </div>

    <!-- Dosya Kartları Listesi -->
    <div class="ml-filemap-grid" data-file-grid>
      {dosyalar.map((d) => (
        <article
          class="ml-file-card"
          data-file-module={d.modul}
          data-file-path={d.yol.toLowerCase()}
          data-file-name={d.ad.toLowerCase()}
          data-file-text={`${d.neYapiyor} ${d.icerik.join(' ')} ${d.kaldirirsak}`.toLowerCase()}
        >
          <div class="ml-file-card__head">
            <div class="ml-file-card__title-box">
              <span class="ml-file-card__icon" aria-hidden="true">
                {d.dil === 'Rust' ? '🦀' : d.dil === 'JavaScript' ? '📜' : d.dil === 'JSON' ? '📋' : '⚙️'}
              </span>
              <div>
                <h3 class="ml-file-card__path">{d.yol}</h3>
                <span class="ml-file-card__module">{d.modulAdi} · {d.dil}</span>
              </div>
            </div>
            <div class="ml-file-card__badges">
              <span class:list={['ml-file-card__onem', `is-${d.onem.toLowerCase()}`]}>
                {d.onem}
              </span>
            </div>
          </div>

          <div class="ml-file-card__body">
            <div class="ml-file-card__section">
              <span class="ml-file-card__label">🎯 Ne Yapıyor?</span>
              <p class="ml-file-card__desc">{d.neYapiyor}</p>
            </div>

            <div class="ml-file-card__section">
              <span class="ml-file-card__label">📦 İçindekiler & Bileşenler</span>
              <ul class="ml-file-card__list">
                {d.icerik.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <div class="ml-file-card__section ml-file-card__section--warning">
              <span class="ml-file-card__label">⚠️ Kaldırırsak Ne Olur?</span>
              <p class="ml-file-card__warn-text">{d.kaldirirsak}</p>
            </div>
          </div>

          {d.kodLinki && (
            <div class="ml-file-card__foot">
              <a class="ml-file-card__code-link" href={d.kodLinki}>
                <span>💻 Bu dosyanın kaynak kod analizini oku</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="ml-filemap-empty" data-file-empty hidden>
      <p>Arama kriterinize uygun dosya bulunamadı.</p>
      <small>Farklı bir anahtar kelime deneyebilir veya filtreyi "Tüm Dosyalar" yapabilirsiniz.</small>
    </div>
  </Section>
</Base>

<script is:inline>
  function mlDepoHaritasiKur() {
    var tabs = document.querySelectorAll('[data-file-filter]');
    var searchInput = document.querySelector('[data-file-search]');
    var cards = document.querySelectorAll('.ml-file-card');
    var emptyBox = document.querySelector('[data-file-empty]');

    if (!cards.length) return;

    var aktifModul = 'hepsi';
    var aktifArama = '';

    function turkceKucult(s) {
      return (s || '')
        .toLowerCase()
        .replace(/ı/g, 'i')
        .replace(/ğ/g, 'g')
        .replace(/ü/g, 'u')
        .replace(/ş/g, 's')
        .replace(/ö/g, 'o')
        .replace(/ç/g, 'c');
    }

    function filtrele() {
      var gorunen = 0;
      cards.forEach(function (card) {
        var mod = card.getAttribute('data-file-module');
        var path = card.getAttribute('data-file-path') || '';
        var name = card.getAttribute('data-file-name') || '';
        var text = card.getAttribute('data-file-text') || '';

        var modUygun = (aktifModul === 'hepsi' || mod === aktifModul);
        var aramaUygun = true;

        if (aktifArama) {
          var kText = turkceKucult(path + ' ' + name + ' ' + text);
          aramaUygun = kText.indexOf(aktifArama) !== -1;
        }

        if (modUygun && aramaUygun) {
          card.hidden = false;
          gorunen++;
        } else {
          card.hidden = true;
        }
      });

      if (emptyBox) {
        emptyBox.hidden = gorunen > 0;
      }
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) { t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        aktifModul = tab.getAttribute('data-file-filter') || 'hepsi';
        filtrele();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        aktifArama = turkceKucult(searchInput.value.trim());
        filtrele();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mlDepoHaritasiKur);
  } else {
    mlDepoHaritasiKur();
  }
</script>

<style>
  .ml-filemap-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }
  .ml-filemap-stat {
    padding: 1rem 1.25rem;
    background: var(--ml-card-bg);
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .ml-filemap-stat__num {
    font-family: var(--ml-font-display);
    font-size: var(--ml-step-2);
    font-weight: 700;
    color: var(--ml-scan);
  }
  .ml-filemap-stat__label {
    font-family: var(--ml-font-mono);
    font-size: 0.72rem;
    color: var(--ml-ink-muted);
    letter-spacing: 0.04em;
  }

  /* Filtre Çubuğu */
  .ml-filemap-filterbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
