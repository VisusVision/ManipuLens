---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Layer from '../components/Layer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface DosyaBilgisi {
  yol: string;
  modul: 'backend' | 'extension' | 'config' | 'site';
  modulAdi: string;
  ad: string;
  dil: string;
  neYapiyor: string;
  icerik: string[];
  kaldirirsak: string;
  onem: 'Kritik' | 'Yüksek' | 'Orta' | 'Yardımcı';
  kodLinki?: string;
}

const dosyalar: DosyaBilgisi[] = [
  // 1. Rust Backend (src/)
  {
    yol: 'src/main.rs',
    modul: 'backend',
    modulAdi: 'Rust Sunucu (Axum)',
    ad: 'main.rs',
    dil: 'Rust',
    neYapiyor: 'Backend HTTP sunucusunu başlatır, TCP soketini dinler, CORS ve middleware katmanlarını ekler, API rota ağacını kurar.',
    icerik: [
      'tokio::main asenkron runtime başlatıcı',
      'Axum Router ve API rotaları (/api/analyze, /api/auth, /api/audit)',
      'Tower HTTP CORS ve tracing middleware zinciri',
      'Veritabanı havuzu (SqlitePool) ve ortam değişkenleri (.env) yükleme'
    ],
    kaldirirsak: 'Sunucu ayağa kalkmaz; Chrome uzantısı hiçbir API isteğine yanıt alamaz.',
    onem: 'Kritik',
    kodLinki: `${base}/kod#axum-rota-agaci`
  },
  {
    yol: 'src/agents.rs',
    modul: 'backend',
    modulAdi: 'Rust Sunucu (Axum)',
    ad: 'agents.rs',
    dil: 'Rust',
    neYapiyor: '6 uzman manipülasyon ajanının prompt şablonlarını yönetir, LLM API çağrılarını yapar ve API çökmesinde esnek regex motoruna geri düşer.',
    icerik: [
      '6 Ajanın prompt derleyicisi (Algısal, Dilsel, Psikolojik, Davranışsal, Sosyal, Pazarlama)',
      'Gemini / OpenAI API HTTP istek istemcisi',
      'Regex tabanlı çevrimdışı manipülasyon tespit fallback fonksiyonları',
      'JSON yanıt ayrıştırıcı ve hata yakalayıcı'
    ],
    kaldirirsak: 'Ajanlar metinleri analiz edemez; manipülasyon tespiti tamamen durur.',
    onem: 'Kritik',
    kodLinki: `${base}/kod#paralel-ajanlar`
  },
  {
    yol: 'src/orchestrator.rs',
    modul: 'backend',
    modulAdi: 'Rust Sunucu (Axum)',
    ad: 'orchestrator.rs',
    dil: 'Rust',
    neYapiyor: 'Ajanların paralel çalışmasını koordine eder, önbellek kontrolü yapar, 6 ajanın puanlarını ağırlıklı güven skoruna dönüştürür.',
    icerik: [
      'tokio::join! / FuturesUnordered ile paralel ajan işletimi',
      'LRU bellek içi analiz önbelleği (Cache)',
      'Güven puanı (Trust Score) ağırlıklı ortalama algoritması',
      'Kritik eşik aşımında tetiklenen acil bayraklar'
    ],
    kaldirirsak: 'Ajanlar paralel çalışamaz, analiz süresi 6 katına çıkar, skor konsolidasyonu yapılamaz.',
    onem: 'Kritik',
    kodLinki: `${base}/kod#sef-sonucunu-rapora-cevirme`
  },
  {
    yol: 'src/auth.rs',
    modul: 'backend',
    modulAdi: 'Rust Sunucu (Axum)',
    ad: 'auth.rs',
    dil: 'Rust',
    neYapiyor: 'Kullanıcı kaydı, giriş doğrulama, JWT token üretimi ve brute-force saldırılarına karşı IP hız sınırlamasını yürütür.',
    icerik: [
      'Argon2 şifre hashleme ve doğrulama',
      'JWT (JSON Web Token) üretimi ve Bearer token middleware',
      'Hız limiti (Rate Limiting) ve başarısız giriş kilit mekanizması',
      'E-posta doğrulama kodu yönetimi (isteğe bağlı)'
    ],
    kaldirirsak: 'Kullanıcı hesapları ve güvenli oturum yönetimi çalışmaz; API herkese açık kalır.',
    onem: 'Yüksek',
    kodLinki: `${base}/kod#giris-kaba-kuvvet-kilidi`
  },
  {
    yol: 'src/db.rs',
    modul: 'backend',
    modulAdi: 'Rust Sunucu (Axum)',
    ad: 'db.rs',
    dil: 'Rust',
    neYapiyor: 'SQLite veritabanı bağlantı havuzunu yönetir, şema tablolarını otomatik oluşturur (migration) ve CRUD işlemlerini yürütür.',
    icerik: [
      'SqlitePool başlatma ve WAL modunu aktifleştirme',
      'Kullanıcılar, denetim kayıtları ve ayarlar tabloları şeması',
      'Geçmiş sorguları ve analitik veri çekme fonksiyonları',
      'Eski verilerin otomatik temizlenme (retention) döngüsü'
    ],
    kaldirirsak: 'Veri kalıcılığı kaybolur, kullanıcı ayarları ve denetim logları saklanamaz.',
    onem: 'Kritik',
    kodLinki: `${base}/kod#eski-veriyi-bir-kez-tasima`
  },
  {
    yol: 'src/audit.rs',
    modul: 'backend',
    modulAdi: 'Rust Sunucu (Axum)',
    ad: 'audit.rs',
    dil: 'Rust',
    neYapiyor: 'Yapılan her analizi gizlilik filtrelerinden geçirerek yerel diskte JSONL formatında denetim günlüğü olarak kaydeder.',
    icerik: [
      'Kişisel veri (PII) maskeleme ve temizleme',
      'Günlük JSONL dosya rotasyonu (logs/audit-YYYY-MM-DD.jsonl)',
      'Denetim izi hash zinciri doğrulama'
    ],
    kaldirirsak: 'Şeffaflık ve denetim kayıtları tutulamaz, geçmiş analiz incelemesi yapılamaz.',
    onem: 'Orta',
    kodLinki: `${base}/kod#denetim-onizleme`
  },
  {
    yol: 'src/profile.rs',
    modul: 'backend',
    modulAdi: 'Rust Sunucu (Axum)',
    ad: 'profile.rs',
    dil: 'Rust',
    neYapiyor: 'Kullanıcının demografik hassasiyet tercihlerini ve özel tetikleyici anahtar kelime eşiklerini saklar.',
    icerik: [
      'Kullanıcı hassasiyet seviyesi (Düşük / Standart / Yüksek)',
      'Ajan bazlı özel eşik değerleri (Threshold overrides)',
      'Özel engelleme ve beyaz liste kuralları'
    ],
    kaldirirsak: 'Analizler kişiselleştirilemez, herkes için varsayılan genel eşikler geçerli olur.',
    onem: 'Orta'
  },
  {
    yol: 'src/types.rs',
    modul: 'backend',
    modulAdi: 'Rust Sunucu (Axum)',
    ad: 'types.rs',
    dil: 'Rust',
    neYapiyor: 'Backend ile eklenti arasında taşınan tüm veri yapılarının (DTO) Rust struct ve Serde serileştirme tanımlarını içerir.',
