    onem: 'Kritik',
    kodLinki: `${base}/kod#rapor-veri-sozlesmesi`
  },

  // 2. Chrome Extension (extension/)
  {
    yol: 'extension/manifest.json',
    modul: 'extension',
    modulAdi: 'Chrome Uzantısı (MV3)',
    ad: 'manifest.json',
    dil: 'JSON',
    neYapiyor: 'Chrome Manifest V3 standardında eklentinin izinlerini, arka plan betiğini, popup penceresini ve simgelerini Chrome\'a tanıtır.',
    icerik: [
      'Manifest V3 bildirimleri ve izinler (contextMenus, storage, activeTab)',
      'Background service worker (background.js) tanımı',
      'Action popup (popup.html) ve ikon yolları'
    ],
    kaldirirsak: 'Chrome uzantıyı tanıyamaz ve tarayıcıya yüklenemez.',
    onem: 'Kritik'
  },
  {
    yol: 'extension/background.js',
    modul: 'extension',
    modulAdi: 'Chrome Uzantısı (MV3)',
    ad: 'background.js',
    dil: 'JavaScript',
    neYapiyor: 'Tarayıcıda sağ tık menüsünü ("ManipuLens ile İncele") yönetir, seçilen metni backend API\'ye iletir ve analiz sonucunu popup\'a aktarır.',
    icerik: [
      'chrome.contextMenus.create sağ tık bağlam menüsü kurulumu',
      'chrome.contextMenus.onClicked olay dinleyicisi',
      'Backend API fetch isteği ve auth token yönetimi',
      'chrome.storage.local üzerine son analiz sonucunu yazma'
    ],
    kaldirirsak: 'Sağ tık menüsü kaybolur, web sayfalarından doğrudan metin seçip analiz etme imkanı biter.',
    onem: 'Kritik',
    kodLinki: `${base}/kod#sag-tik-menusu`
  },
  {
    yol: 'extension/popup.html',
    modul: 'extension',
    modulAdi: 'Chrome Uzantısı (MV3)',
    ad: 'popup.html',
    dil: 'HTML',
    neYapiyor: 'Eklenti ikonuna tıklandığında açılan ana kullanıcı arayüzünü (Dashboard, Güven Skoru, Ajan Bulguları) sunar.',
    icerik: [
      'Güven Skoru dairesel gösterge kartı',
      '6 Ajanın renkli durum rozetleri ve tespit edilen şüpheli cümleler',
      'Giriş yapma / Profil ayarları panelleri'
    ],
    kaldirirsak: 'Kullanıcı eklenti arayüzünü göremez ve analiz sonuçlarını görsel olarak okuyamaz.',
    onem: 'Kritik'
  },
  {
    yol: 'extension/popup.js',
    modul: 'extension',
    modulAdi: 'Chrome Uzantısı (MV3)',
    ad: 'popup.js',
    dil: 'JavaScript',
    neYapiyor: 'Popup arayüzündeki DOM elemanlarını yönetir, yerel depolamadan son analiz verisini çeker ve dinamik renk/skor render eder.',
    icerik: [
      'chrome.storage.local üzerinden son raporu dinleme ve render etme',
      'Güven skoruna göre yeşil/turuncu/kırmızı renk sınıflandırması',
      'Ajan filtreleme ve detay açma/kapatma etkileşimi'
    ],
    kaldirirsak: 'Popup içi boş kalır, dinamik skor ve ajan kartları yüklenemez.',
    onem: 'Kritik'
  },

  // 3. Konfigürasyon & Dağıtım
  {
    yol: 'Cargo.toml',
    modul: 'config',
    modulAdi: 'Konfigürasyon & Dağıtım',
    ad: 'Cargo.toml',
    dil: 'TOML',
    neYapiyor: 'Rust projesinin paket adını, sürümünü ve harici kütüphane bağımlılıklarını (Axum, Tokio, Serde, Reqwest vb.) tanımlar.',
    icerik: [
      'Paket adı, sürüm (0.1.0) ve Rust edisyonu (2021)',
      'Web framework (axum), Asenkron çalışma motoru (tokio)',
      'Serileştirme (serde, serde_json) ve HTTP istemci (reqwest)',
      'Veritabanı (sqlx/rusqlite), Güvenlik (argon2, jsonwebtoken)'
    ],
    kaldirirsak: 'Rust derleyicisi projeyi derleyemez.',
    onem: 'Kritik'
  },
  {
    yol: 'Dockerfile',
    modul: 'config',
    modulAdi: 'Konfigürasyon & Dağıtım',
    ad: 'Dockerfile',
    dil: 'Dockerfile',
    neYapiyor: 'ManipuLens backend sunucusunu izole, güvenli ve hafif bir Linux Docker konteyneri olarak çok aşamalı (multi-stage) derler.',
    icerik: [
      'Aşama 1 (Builder): Rust alpine tabanında statik binary derleme',
      'Aşama 2 (Runtime): Minimal distroless/alpine imajında 20MB hafif dağıtım',
      'Güvenli non-root kullanıcı ve 3000 port yayını'
    ],
    kaldirirsak: 'Docker tabanlı sunucu ve bulut dağıtımı manuel kurulum gerektirir.',
    onem: 'Yüksek'
  },
  {
    yol: 'docker-compose.yml',
    modul: 'config',
    modulAdi: 'Konfigürasyon & Dağıtım',
    ad: 'docker-compose.yml',
    dil: 'YAML',
    neYapiyor: 'Backend servisini, veritabanı hacmini (volume) ve ortam değişkenlerini tek bir `docker-compose up` komutuyla ayağa kaldırır.',
    icerik: [
      'manipulens-server servis tanımı ve port eşleme (3000:3000)',
      'Kalıcı veri hacmi (./data:/app/data) eşleştirmesi',
      'Ortam değişkenleri (RUST_LOG, PORT, DATABASE_URL) ayarları'
    ],
    kaldirirsak: 'Konteynerleri tek komutla orkestre etmek zorlaşır.',
    onem: 'Orta'
  },
  {
    yol: 'SETUP_MAIL.md',
    modul: 'config',
    modulAdi: 'Dokümantasyon',
    ad: 'SETUP_MAIL.md',
    dil: 'Markdown',
    neYapiyor: 'E-posta doğrulama adımının nasıl kurulacağını, test edileceğini veya opsiyonel olarak nasıl kapatılacağını açıklar.',
    icerik: [
      'SMTP sunucu ayarları (Gmail, Mailgun, vb.)',
      'E-posta doğrulamasını devre dışı bırakma bayrağı (DISABLE_MAIL_AUTH=true)',
      'Geliştirici yerel test kılavuzu'
    ],
    kaldirirsak: 'Geliştiriciler mail ayarlarını yapılandırırken hata yapabilir.',
    onem: 'Yardımcı'
