---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Layer from '../components/Layer.astro';
import CodeWalk from '../components/CodeWalk.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import { getCollection } from 'astro:content';

/**
 * Alti parca tek sayfada, sirayla okunur. Yandaki ray kaydirdikca kendiliginden
 * 01'den 06'ya ilerler - okuyucu nerede oldugunu her an bilir.
 *
 * Ayri /parcalar/<slug> sayfalari duruyor: derin baglantilar ve tek bir parcayi
 * paylasmak icin. Bu sayfa onlarin yerine gecmiyor, sirali okuma yolunu veriyor.
 */
const parcalar = (await getCollection('parcalar')).sort((a, b) => a.data.order - b.data.order);
const kodlar = (await getCollection('kod')).sort((a, b) => a.data.order - b.data.order);

function kapsamliGovde(html: string, onek: string) {
  // Tekil parca sayfasinda h2/h3 olan Markdown basliklari, bu birlesik sayfada
  // parca h2'sinin altina iner. Kimlikler de parca onekiyle sayfa genelinde tekil olur.
  return html
    .replace(/<h3([^>]*)>/g, '<h4$1>')
    .replace(/<\/h3>/g, '</h4>')
    .replace(/<h2([^>]*)>/g, '<h3$1>')
    .replace(/<\/h2>/g, '</h3>')
    .replace(/ id="([^"]+)"/g, ` id="${onek}-$1"`)
    .replace(/ href="#([^"]+)"/g, ` href="#${onek}-$1"`);
}

const bolumler = parcalar.map((p) => ({
    veri: p.data,
    id: p.id,
    govdeHtml: kapsamliGovde(p.rendered?.html ?? '', p.id),
    kodlar: kodlar.filter((k) => k.data.parca === p.id),
  }));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const no = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Parçalar"
  description="ManipuLens hangi parçalardan oluşuyor: uzantı, sunucu, orkestratör, model, hesap, veri."
>
  <Section
    as="h1"
    num="00"
    kicker="Sistem envanteri"
    title="Parçalar"
    lede="ManipuLens tek bir program değil, altı ayrı sorumluluğu olan altı parça. Aşağıya doğru okudukça sırayla hepsinden geçeceksin; yandaki ray nerede olduğunu gösterir."
  >
    <EvidenceBadge commit="d992153" verifiedAt={new Date('2026-08-30T00:00:00+03:00')} owner="ManipuLens ekibi" />

    <dl class="ml-sorumluluk">
      {parcalar.map((p) => (
        <div>
          <dt>
            <a href={`#${p.id}`}>
              <span class="ml-sorumluluk__no">{no(p.data.order)}</span>
              {p.data.title}
            </a>
          </dt>
          <dd>{p.data.sorumluluk}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <div class="ml-akis">
    <div class="ml-akis__govde">
      {bolumler.map(({ veri, id, govdeHtml, kodlar: kp }) => (
        <section class="ml-parca-bolum rv" id={id} data-parca={id}>
          <p class="ml-parca-bolum__ust">
            <span class="ml-parca-bolum__no">{no(veri.order)}</span>
            <span>Parça</span>
          </p>
          <h2 class="ml-parca-bolum__ad">{veri.title}</h2>
          <p class="ml-parca-bolum__kisaca">{veri.kisaca}</p>

          <dl class="ml-kunye">
            <div>
              <dt>Sorumluluk</dt>
              <dd>{veri.sorumluluk}</dd>
            </div>
            <div class="ml-technical">
              <dt>Dosyalar</dt>
              <dd><code>{veri.dosyalar}</code></dd>
            </div>
          </dl>

          <article class="ml-prose ml-parca-govde" set:html={govdeHtml} />

          {kp.length > 0 && (
            <div class="ml-technical ml-parca-kod">
              <h3>Kod okuma</h3>
              {kp.map((k) => (
                <CodeWalk
                  id={k.id}
                  baslik={k.data.title}
                  dosya={k.data.dosya}
                  dil={k.data.dil}
                  neYapiyor={k.data.ne_yapiyor}
                  nedenBoyle={k.data.neden_boyle}
                  kaldirirsak={k.data.kaldirirsak}
                  notlar={k.data.notlar}
                  sina={k.data.sina}
                  zorluk={k.data.zorluk}
                />
              ))}
            </div>
          )}

          <p class="ml-parca-bolum__tek">
            <a href={`${base}/parcalar/${id}`}>Bu parçayı tek başına aç →</a>
          </p>
        </section>
      ))}
    </div>
  </div>

  <Section
    num="07"
    kicker="Ölçek"
    title="Sistemin büyüklüğü"
    lede="Bu boyut önemli: sistem tek kişinin bir hafta sonunda okuyup anlayabileceği büyüklükte."
  >
    <Layer kind="technical" title="Satır sayıları">
      <p>
        Rust tarafı yaklaşık 3.640 satır (<code>main.rs</code> 1.438,
        <code>db.rs</code> 504, <code>profile.rs</code> 474,
        <code>orchestrator.rs</code> 441, <code>agents.rs</code> 330,
        <code>types.rs</code> 229, <code>auth.rs</code> 162,
        <code>audit.rs</code> 65). Uzantı tarafı yaklaşık 1.950 satır
        (<code>popup.js</code> 1.511, <code>background.js</code> 443).
      </p>
    </Layer>
  </Section>
</Base>

<style>
  .ml-sorumluluk { margin: 1.5rem 0 0; display: grid; gap: 0.75rem; }
  .ml-sorumluluk div {
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) 1fr;
    gap: 0.4rem 1.2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ml-line-soft);
  }
  @media (max-width: 40rem) {
    .ml-sorumluluk div { grid-template-columns: 1fr; }
  }
  .ml-sorumluluk dt { font-family: var(--ml-font-display); font-weight: 700; }
  .ml-sorumluluk dt a { text-decoration: none; display: inline-flex; gap: 0.5rem; }
  .ml-sorumluluk dt a:hover { text-decoration: underline; text-decoration-color: var(--ml-scan); }
  .ml-sorumluluk__no { font-family: var(--ml-font-mono); font-size: 0.7em; color: var(--ml-scan); }
  .ml-sorumluluk dd { margin: 0; color: var(--ml-ink-muted); }

  /* --- Tek sayfalik akis --- */
  .ml-akis {
    margin-top: 2rem;
  }
  .ml-akis__govde { min-width: 0; }

  .ml-parca-bolum {
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
    border-top: 1px solid var(--ml-line-soft);
    scroll-margin-top: 6rem;
  }
  .ml-parca-bolum:first-child { border-top: 0; padding-top: 0; }
  .ml-parca-bolum__ust {
    margin: 0 0 0.3rem;
    max-width: none;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-family: var(--ml-font-mono);
    font-size: var(--ml-step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  .ml-parca-bolum__no { color: var(--ml-scan); }
  .ml-parca-bolum__ad { margin: 0 0 0.6rem; }
  .ml-parca-bolum__kisaca {
    font-size: var(--ml-step-1);
    line-height: 1.5;
    max-width: 58ch;
    margin: 0 0 1.25rem;
  }
  .ml-parca-bolum__tek {
    margin-top: 1.5rem;
    font-family: var(--ml-font-mono);
    font-size: var(--ml-step--1);
  }

  .ml-kunye {
    margin: 0 0 1.75rem;
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    background: var(--ml-paper-warm);
    border-left: 4px solid var(--ml-scan);
    border-radius: var(--ml-radius);
  }
  .ml-kunye dt {
    font-family: var(--ml-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  .ml-kunye dd { margin: 0.15rem 0 0; }
  .ml-kunye code { word-break: break-word; }

  .ml-parca-govde :global(h3) {
    margin: 2rem 0 0.6rem;
    font-size: var(--ml-step-1);
    padding-top: 1.2rem;
    border-top: 1px solid var(--ml-line-soft);
  }
  .ml-parca-govde :global(h4) { margin: 1.5rem 0 0.5rem; }
  .ml-parca-govde :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: var(--ml-step--1);
  }
  .ml-parca-govde :global(th),
  .ml-parca-govde :global(td) {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--ml-line-soft);
    vertical-align: top;
  }
  .ml-parca-govde :global(th) {
    font-family: var(--ml-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  .ml-parca-govde :global(pre) { overflow-x: auto; }

  .ml-parca-kod { margin-top: 2rem; }
</style>
