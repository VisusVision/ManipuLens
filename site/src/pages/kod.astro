---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CodeWalk from '../components/CodeWalk.astro';
import Layer from '../components/Layer.astro';
import { getCollection, render } from 'astro:content';

const parcalar = (await getCollection('kod')).sort((a, b) => a.data.order - b.data.order);
const govdeler = await Promise.all(
  parcalar.map(async (p) => ({ veri: p.data, id: p.id, Govde: (await render(p)).Content })),
);

const zorlukSayi = (z: string) => parcalar.filter((p) => p.data.zorluk === z).length;

const ZORLUK_ADI: Record<string, string> = {
  baslangic: 'Başlangıç',
  orta: 'Orta',
  ileri: 'İleri',
};
---
<Base
  title="Kod okuma"
  description="Gerçek kod, satır satır: ne yapıyor, neden böyle, kaldırırsak ne olur."
>
  <Section
    as="h1"
    num="00"
    kicker="Vibe coding panzehiri"
    title="Kod okuma"
    lede="Kod çalışıyor ama neyin neye yaradığını bilmiyorsan, benzer bir yer yazman gerektiğinde yine tahmin edeceksin. Bu bölüm ezber için değil, okuma refleksi için var."
  >
    <p class="ml-prose">
      Buradaki her parça <strong>gerçek koddan</strong> geliyor — elle kopyalanmıyor,
      kaynaktan kesiliyor. Her parça üç soruyu birden cevaplıyor:
    </p>
    <ol class="ml-uclu-liste">
      <li><strong>Ne yapıyor?</strong> Tek cümle, terimsiz.</li>
      <li><strong>Neden böyle?</strong> Alternatifi neydi, neden seçilmedi.</li>
      <li><strong>Kaldırırsak ne olur?</strong> Hangi test kırılır, kullanıcı ne yaşar.</li>
    </ol>
    <p class="ml-prose">
      Üçüncüsü en önemlisi. Bir satırın varlık sebebini test eden tek soru bu; cevabı yoksa ya
      satır gereksizdir ya da henüz kimse anlamamıştır. İkisi de yazmaya değer bir bulgudur.
      Cevabı <em>“böyle alışılmış”</em> olan bir parça bu listeye girmiyor.
    </p>

    <p class="ml-kod-ozet">
      <span><strong>{parcalar.length}</strong> parça</span>
      <span><strong>{zorlukSayi('baslangic')}</strong> başlangıç</span>
      <span><strong>{zorlukSayi('orta')}</strong> orta</span>
      <span><strong>{zorlukSayi('ileri')}</strong> ileri</span>
    </p>

    <Layer kind="technical" title="Kod nasıl güncel kalıyor" as="h2">
      <p>
        <code>scripts/extract-code.mjs</code> her derlemede kaynağı yeniden okuyor, satır
        aralığını kesiyor ve dosyanın hash'ini kaydediyor. Kaynak değişip açıklama
        güncellenmezse <code>npm run kod:kontrol</code> hata veriyor. Elle kopyalanan kod
        sessizce eskir; üretilen kod eskiyemez, çünkü eskidiği anda gürültü çıkarır.
      </p>
      <p>
        Şema üç sorunun üçünü de zorunlu tutuyor. Biri boş bırakılırsa derleme duruyor —
        “sonra yazarım” diye eksik parça yayına giremiyor.
      </p>
    </Layer>
  </Section>

  <Section
    num="01"
    kicker="Parça parça"
    title="Okuma listesi"
    id="liste"
    lede="Her parça kapalı duruyor: başlık, dosya ve tek cümlelik özet bir bakışta görünür. Okumak istediğini aç — açılan parça tam genişliğe yayılır, kod ve notlar yan yana kalır."
  >
    <div class="ml-kod-grid">
      {govdeler.map(({ veri, id, Govde }, i) => (
        <details class="ml-kod-kart" id={`p-${id}`}>
          <summary class="ml-kod-kart__bas">
            <span class="ml-kod-kart__no">{String(i + 1).padStart(2, '0')}</span>
            <span class="ml-kod-kart__ana">
              <span class="ml-kod-kart__ust">
                <span class="ml-kod-kart__parca">{veri.parca}</span>
                <span class="ml-kod-kart__z" data-z={veri.zorluk}>{ZORLUK_ADI[veri.zorluk]}</span>
              </span>
              <span class="ml-kod-kart__ad">{veri.title}</span>
              <span class="ml-kod-kart__ne">{veri.ne_yapiyor}</span>
              <code class="ml-kod-kart__dosya">{veri.dosya}</code>
            </span>
            <span class="ml-kod-kart__ok" aria-hidden="true"></span>
          </summary>
          <div class="ml-kod-kart__ic">
            <div class="ml-prose ml-kod-giris"><Govde /></div>
            <CodeWalk
              id={id}
              baslik={veri.title}
              dosya={veri.dosya}
              dil={veri.dil}
              neYapiyor={veri.ne_yapiyor}
              nedenBoyle={veri.neden_boyle}
              kaldirirsak={veri.kaldirirsak}
              notlar={veri.notlar}
              sina={veri.sina}
              zorluk={veri.zorluk}
            />
          </div>
        </details>
      ))}
    </div>
  </Section>

  <script is:inline>
    (function () {
      var kartlar = Array.prototype.slice.call(document.querySelectorAll('.ml-kod-kart'));
      if (!kartlar.length) return;

      /* Kart kapaliyken icindeki .rv bloklarinin yuksekligi sifir; gozlemci onlari
         hic gormuyor, acilinca opaklik 0'da takili kalirlardi. */
      function gorunurYap(kart) {
        kart.querySelectorAll('.rv:not(.rv--in)').forEach(function (el) {
          el.classList.add('rv--in');
        });
      }

      kartlar.forEach(function (kart) {
        kart.addEventListener('toggle', function () {
          if (kart.open) gorunurYap(kart);
        });
      });

      /* Disaridan gelen iki baglanti bicimi de karti acmali: kartin kendi
         kimligi (#p-<id>) ve CodeWalk bolumunun kimligi (#<id>) - depo
         haritasi, arama paneli ve ajan sayfasi ikincisini kullaniyor. */
      function hashtanAc() {
        if (!location.hash) return;
        var hedef;
        try {
          hedef = document.querySelector(location.hash);
        } catch (e) {
          return;
        }
        if (!hedef) return;
        var kart = hedef.closest('.ml-kod-kart');
        if (!kart) return;
        kart.open = true;
        gorunurYap(kart);
        hedef.scrollIntoView({ block: 'start' });
      }

      window.addEventListener('hashchange', hashtanAc);
      hashtanAc();
    })();
  </script>
</Base>

<style>
  /* 17 parca alt alta tam genislik dururken sayfa binlerce piksel uzuyordu;
     birini bulmak icin butun listeyi kaydirmak gerekiyordu. Kapali kartlar iki
     sutunda duruyor, acilan kart iki sutunu birden kaplayip eski tam genislikli
     gorunume donuyor - CodeWalk'un kod/not ikilisi bozulmuyor. */
  .ml-kod-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
    align-items: start;
  }
  @media (max-width: 52rem) {
    .ml-kod-grid { grid-template-columns: 1fr; }
  }

  .ml-kod-kart {
    background: var(--ml-card-bg);
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius);
    box-shadow: var(--ml-shadow-sm);
    scroll-margin-top: calc(var(--ml-sticky-h, 7rem) + 1rem);
    transition: border-color var(--ml-duration) var(--ml-ease),
                box-shadow var(--ml-duration) var(--ml-ease);
  }
  .ml-kod-kart:hover { border-color: var(--ml-scan); box-shadow: var(--ml-shadow-md); }
  .ml-kod-kart[open] {
    grid-column: 1 / -1;
    border-color: var(--ml-scan);
    box-shadow: var(--ml-shadow-md);
  }

  .ml-kod-kart__bas {
    display: grid;
    grid-template-columns: 2.2rem 1fr 1rem;
    gap: 0.2rem 0.8rem;
    align-items: start;
    padding: 0.85rem 0.95rem;
    cursor: pointer;
    list-style: none;
  }
  .ml-kod-kart__bas::-webkit-details-marker { display: none; }

  .ml-kod-kart__no {
    font-family: var(--ml-font-mono);
    font-size: var(--ml-step--1);
    font-weight: 700;
    color: var(--ml-scan);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }
  .ml-kod-kart__ana { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .ml-kod-kart__ust { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.6rem; }
  .ml-kod-kart__parca {
    font-family: var(--ml-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ml-ink-muted);
  }
  .ml-kod-kart__z {
    font-family: var(--ml-font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.1rem 0.42rem;
    border: 1px solid var(--ml-line-soft);
    border-radius: var(--ml-radius-sm);
  }
  .ml-kod-kart__z[data-z='baslangic'] { border-color: var(--ml-ok); color: var(--ml-ok); background: rgba(0, 110, 99, 0.08); }
  .ml-kod-kart__z[data-z='orta'] { border-color: var(--ml-warn); color: var(--ml-warn); background: rgba(168, 78, 0, 0.08); }
  .ml-kod-kart__z[data-z='ileri'] { border-color: var(--ml-risk); color: var(--ml-risk); background: rgba(166, 0, 78, 0.08); }

  .ml-kod-kart__ad {
    font-family: var(--ml-font-display);
    font-weight: 700;
    font-size: var(--ml-step-0);
    line-height: 1.25;
  }
  .ml-kod-kart__ne {
    font-size: var(--ml-step--1);
    line-height: 1.45;
    color: var(--ml-ink-muted);
  }
  .ml-kod-kart__dosya {
    font-size: 0.7rem;
    color: var(--ml-ink-muted);
    background: none;
    border: 0;
    padding: 0;
    overflow-wrap: anywhere;
  }

  /* Acilma yonunu gosteren isaret; salt CSS, betige bagli degil. */
  .ml-kod-kart__ok {
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.4rem;
    border-right: 2px solid var(--ml-ink-muted);
    border-bottom: 2px solid var(--ml-ink-muted);
    transform: rotate(45deg);
    transition: transform var(--ml-duration) var(--ml-ease);
  }
  .ml-kod-kart[open] .ml-kod-kart__ok { transform: rotate(-135deg); }

  .ml-kod-kart__ic { padding: 0 0.95rem 0.4rem; border-top: 1px solid var(--ml-line-soft); }
  .ml-kod-kart__ic :global(.ml-kw) { margin-block: 1rem; }

  .ml-uclu-liste { max-width: var(--ml-measure); }
  .ml-uclu-liste li { margin-bottom: 0.3rem; }
  .ml-kod-ozet {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 1.25rem 0;
    max-width: none;
    font-family: var(--ml-font-mono);
    font-size: var(--ml-step--1);
    color: var(--ml-ink-muted);
  }
  .ml-kod-ozet strong { color: var(--ml-ink); font-size: var(--ml-step-1); }
  .ml-kod-giris { margin-bottom: 0.5rem; }
</style>
