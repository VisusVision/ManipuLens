---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Taslak kayitlar listede gorunur ama "taslak" isaretiyle; insan onayi olmadan
// yayin sayilmaz. Ekip disina acilacak surumde visibility === 'public' filtresi eklenir.
const kayitlar = (await getCollection('guncellemeler')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const durumEtiket: Record<string, string> = {
  draft: 'Taslak',
  released: 'Yayınlandı',
  reverted: 'Geri alındı',
};
---
<Base title="Güncellemeler" description="Her değişiklik sade ve teknik iki anlatımla.">
  <h1>Güncellemeler</h1>
  <p class="ml-lede ml-prose">
    Her kayıt iki anlatım taşır: herkesin anlayacağı özet ve teknik ayrıntı. Kod birleşmiş
    olması yetmez; test kanıtı ve iki özet olmadan bir değişiklik "yayınlandı" sayılmaz.
  </p>

  {kayitlar.length === 0 && <p>Henüz kayıt yok.</p>}

  <ul class="ml-updates">
    {kayitlar.map((k) => (
      <li class="rv">
        <header>
          <span class={`ml-status ml-status--${k.data.status}`}>{durumEtiket[k.data.status]}</span>
          <time datetime={k.data.date.toISOString()}>{k.data.date.toISOString().slice(0, 10)}</time>
          <span class="ml-chip">{k.data.component}</span>
          {k.data.version && <span class="ml-chip">{k.data.version}</span>}
        </header>
        <h2>{k.data.title}</h2>
        <p class="ml-simple">{k.data.simple_summary}</p>
        {k.data.ne_ise_yarar && (
          <p class="ml-use"><strong>Ne işe yarar:</strong> {k.data.ne_ise_yarar}</p>
        )}

        {k.data.karsilastirma.length > 0 && (
          <div class="ml-ba">
            <h3>Önce / sonra</h3>
            <table>
              <thead>
                <tr><th>Alan</th><th>Önce</th><th>Sonra</th></tr>
              </thead>
              <tbody>
                {k.data.karsilastirma.map((satir) => (
                  <tr>
                    <th scope="row">{satir.alan}</th>
                    <td class="ml-ba-once">{satir.once}</td>
                    <td class="ml-ba-sonra">{satir.sonra}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <div class="ml-technical ml-tech-block ml-dark">
          <div class="ml-tech-block__badge">Teknik Ayrıntı</div>
          <p class="ml-tech-block__lead">{k.data.technical_summary}</p>
          {k.data.why_changed && <p><strong>Neden:</strong> {k.data.why_changed}</p>}
          {k.data.impact && <p><strong>Etki:</strong> {k.data.impact}</p>}
          {k.data.tests && <p><strong>Test:</strong> {k.data.tests}</p>}
          {k.data.known_issues.length > 0 && (
            <p><strong>Bilinen sorunlar:</strong> {k.data.known_issues.join('; ')}</p>
          )}
        </div>
        <footer>
          <span>sahip: {k.data.owner}</span>
          {k.data.commit_or_pr && <a href={k.data.commit_or_pr}>kod</a>}
          {k.data.trello_card && <a href={k.data.trello_card}>Trello kartı</a>}
          {k.data.verified_at_commit && <code>{k.data.verified_at_commit.slice(0, 7)}</code>}
        </footer>
      </li>
    ))}
  </ul>
</Base>

<style>
  .ml-lede { font-size: var(--ml-step-1); max-width: var(--ml-measure); color: var(--ml-ink); margin-bottom: 2rem; }
  .ml-updates { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1.75rem; }
  .ml-updates li {
    border: 1px solid var(--ml-card-border);
    border-radius: var(--ml-radius);
    background: var(--ml-card-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--ml-shadow-sm);
    padding: clamp(1.25rem, 3vw, 2rem);
    transition: transform var(--ml-duration) var(--ml-ease),
                box-shadow var(--ml-duration) var(--ml-ease),
                border-color var(--ml-duration) var(--ml-ease);
  }
  .ml-updates li:hover {
    transform: translateY(-2px);
    box-shadow: var(--ml-shadow-md);
    border-color: var(--ml-scan);
  }
  .ml-updates h2 { font-size: var(--ml-step-1); margin: 0.6rem 0 0.8rem; font-family: var(--ml-font-display); }
  .ml-updates header, .ml-updates footer {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center;
    font-size: var(--ml-step--1); color: var(--ml-ink-muted);
  }
  .ml-updates footer {
    margin-top: 1.25rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--ml-line-soft);
  }
  .ml-simple { max-width: var(--ml-measure); margin: 0; line-height: 1.6; }
  .ml-use {
    max-width: var(--ml-measure);
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.9rem;
    background: var(--ml-scan-dim);
    border-radius: var(--ml-radius-sm);
    font-size: var(--ml-step--1);
  }

  /* Once/sonra: iki durum yan yana durur, "iyilestirildi" demeden fark gorunur. */
  .ml-ba {
    margin-top: 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--ml-line-soft);
    border-radius: var(--ml-radius-sm);
    background: var(--ml-paper);
  }
  .ml-ba h3 {
    font-size: var(--ml-step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ml-scan);
    font-family: var(--ml-font-mono);
    font-weight: 700;
    margin: 0.8rem 1rem 0.4rem;
  }
  .ml-ba table { border-collapse: collapse; width: 100%; min-width: 34rem; font-size: var(--ml-step--1); }
  .ml-ba th, .ml-ba td { text-align: left; vertical-align: top; padding: 0.65rem 0.9rem; border-top: 1px solid var(--ml-line-soft); }
  .ml-ba thead th {
    border-top: 0;
    border-bottom: 2px solid var(--ml-line-soft);
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ml-ink-muted);
    font-family: var(--ml-font-mono);
  }
  .ml-ba tbody th { width: 22%; font-weight: 700; }
  .ml-ba-once { color: var(--ml-ink-muted); background: rgba(0, 0, 0, 0.02); }
  .ml-ba-sonra {
    border-left: 3px solid var(--ml-scan);
    background: var(--ml-scan-dim);
    font-weight: 550;
  }
  .ml-tech-block {
    margin-top: 1.25rem;
    padding: 1.25rem 1.4rem;
    background: var(--ml-navy);
    color: #f0f4fc;
    border-left: 4px solid var(--ml-scan);
    border-radius: var(--ml-radius);
    box-shadow: var(--ml-shadow-md);
    font-size: var(--ml-step--1);
  }
  .ml-tech-block__badge {
    display: inline-block;
    font-family: var(--ml-font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #23c9d6;
    background: rgba(35, 201, 214, 0.15);
    padding: 0.15rem 0.55rem;
    border-radius: var(--ml-radius-sm);
    margin-bottom: 0.6rem;
  }
  .ml-tech-block__lead {
    color: #ffffff !important;
    font-size: var(--ml-step-0);
    line-height: 1.6;
    margin-bottom: 0.75rem !important;
  }
  .ml-tech-block p { margin: 0.4rem 0; max-width: var(--ml-measure); line-height: 1.6; color: #dfe6f2; }
  .ml-tech-block strong {
    color: #23c9d6;
    font-family: var(--ml-font-mono);
    font-size: 0.85em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-right: 0.35rem;
  }
  .ml-tech-block code {
    background: rgba(35, 201, 214, 0.15);
    color: #23c9d6;
    border: 1px solid rgba(35, 201, 214, 0.3);
    padding: 0.1em 0.35em;
    border-radius: var(--ml-radius-sm);
  }
  .ml-chip {
    font-family: var(--ml-font-mono);
    font-size: 0.8em;
    border: 1px solid var(--ml-line-soft);
    background: var(--ml-paper);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }
  .ml-status {
    font-weight: 700;
    font-size: 0.8em;
    font-family: var(--ml-font-mono);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ml-status--draft {
    color: var(--ml-warn);
    background: rgba(168, 78, 0, 0.12);
    border: 1px solid rgba(168, 78, 0, 0.3);
  }
  .ml-status--released {
    color: var(--ml-ok);
    background: rgba(0, 110, 99, 0.12);
    border: 1px solid rgba(0, 110, 99, 0.3);
  }
  .ml-status--reverted {
    color: var(--ml-risk);
    background: rgba(166, 0, 78, 0.12);
    border: 1px solid rgba(166, 0, 78, 0.3);
  }
</style>
