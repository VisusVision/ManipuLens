---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import Layer from '../components/Layer.astro';

/**
 * Uc durum: calisiyor / yapim asamasinda / planlanan.
 * Kural: calismayan hicbir sey "calisiyor" sutununa yazilmaz. Bu sayfanin varlik
 * sebebi ozellik listesi degil, ozellik listesinin durustlugu.
 */
type Durum = 'calisiyor' | 'yapimda' | 'planlanan';

const maddeler: { ad: string; durum: Durum; not: string }[] = [
  // Çalışıyor — doğrulanmış
  { ad: 'Sağ tık ile analiz', durum: 'calisiyor', not: 'Uçtan uca çalışıyor; zincir sayfasında yedi adımın tamamı yazılı.' },
  { ad: 'Altı ajan + sentezör', durum: 'calisiyor', not: 'Paralel çalışma ve ajan başına hata yalıtımı kodda mevcut.' },
  { ad: 'Sayfada renkli işaretleme', durum: 'calisiyor', not: 'Esnek regex ile eşleştirme, CSP dayanıklı stil, eşleşme yoksa yedek hedef.' },
  { ad: 'Hesap, oturum, hız limiti', durum: 'calisiyor', not: 'Bütün sabitler kodda; hesap sayfasında tablo hâlinde.' },
  { ad: 'Analiz geçmişi', durum: 'calisiyor', not: 'SQLite history tablosu, en fazla 200 kayıt.' },
  { ad: 'Denetim kaydı', durum: 'calisiyor', not: 'Günlük JSONL, yalnız 120 karakterlik önizleme.' },
  { ad: 'Yedek özet (fallback)', durum: 'calisiyor', not: 'Sentezöre ulaşılamazsa devreye giriyor; birim testli.' },
  { ad: 'Dil onarımı', durum: 'calisiyor', not: 'Model yanlış dilde cevap verirse alanlar yeniden çevriliyor. Birim testli.' },
  { ad: 'Rapor çevirisi (TR↔EN)', durum: 'calisiyor', not: '/v1/translate-report ucu üzerinden.' },
  { ad: 'Docker imajı', durum: 'calisiyor', not: 'Çok aşamalı derleme, statik musl çıktısı.' },
  { ad: 'Yaşayan rehber sitesi', durum: 'calisiyor', not: '26 statik sayfa yerel derlemede üretiliyor; kaynak ve dokümantasyon aynı repoda.' },
  { ad: 'Kod okuma ve depo haritası', durum: 'calisiyor', not: 'Gerçek kod kesitleri, satır açıklamaları ve dosya kritiklik haritası hazır.' },
  { ad: 'Sayfaların commit doğrulaması', durum: 'calisiyor', not: 'Kaynak iddiaları d992153 commit’i ve 39 geçen Rust testiyle yeniden doğrulandı.' },
  { ad: 'Canlı rehber yayını', durum: 'calisiyor', not: 'Güncel statik derleme Netlify üretim ortamında yayımlanıyor; depo haritası ve yeni navigasyon canlı sürümde mevcut.' },

  // Yapım aşamasında
  { ad: 'Trello panosunun sitede görünmesi', durum: 'yapimda', not: 'Çekim betiği, sayfa ve iş akışı yazıldı. API anahtarı tanımlanınca dolacak.' },

  // Planlanan
  { ad: 'Uzaktan erişim', durum: 'planlanan', not: 'Uzantıdaki sunucu adresi şu an sabit. Açılmadan önce HTTPS ve gerçek CORS kısıtı gerekiyor.' },
  { ad: 'Yedek yolun arayüzde görünmesi', durum: 'planlanan', not: 'Rapor yedek yoldan geldiyse kullanıcı bunu göremiyor. Zayıf raporun zayıf olduğu söylenmeli.' },
  { ad: 'Denetim kaydı saklama süresi', durum: 'planlanan', not: 'Log dosyaları şu an sonsuza kadar birikiyor.' },
  { ad: 'Ajan renk çakışmasının giderilmesi', durum: 'planlanan', not: '“Tüketici Manipülasyonu” Pazarlama ile aynı renkte; bilinmeyen tip Sosyal rengine düşüyor.' },
  { ad: 'Chrome Web Store yayını', durum: 'planlanan', not: 'Şu an yalnız paketlenmemiş öğe olarak yükleniyor.' },
];

const DURUM_ADI: Record<Durum, string> = {
  calisiyor: 'Çalışıyor',
  yapimda: 'Yapım aşamasında',
  planlanan: 'Planlanan',
};
const DURUM_ACIKLAMA: Record<Durum, string> = {
  calisiyor: 'Kodda mevcut ve envanterde doğrulandı.',
  yapimda: 'Başlandı, bitmedi. Bugün kısmen çalışıyor.',
  planlanan: 'Henüz yazılmadı. Bu satırların hiçbiri bugün çalışmıyor.',
};

const sayi = (d: Durum) => maddeler.filter((m) => m.durum === d).length;
---
<Base
  title="Yol haritası"
  description="Ne çalışıyor, ne yapım aşamasında, ne planlanan — çalışmayan hiçbir şey çalışıyor gibi yazılmadan."
>
  <Section
    as="h1"
    num="00"
    kicker="Dürüst liste"
    title="Yol haritası"
    lede="Üç durum var ve aralarındaki sınır serttir. Bir özellik ancak kodda varsa ve envanterde doğrulandıysa “çalışıyor” sütununa girer. Bu sayfanın varlık sebebi özellik listesi değil, listenin dürüstlüğü."
  >
    <EvidenceBadge commit="d992153" verifiedAt={new Date('2026-08-30T00:00:00+03:00')} owner="ManipuLens ekibi" />
    <p class="ml-ozet">
      <span><strong>{sayi('calisiyor')}</strong> çalışıyor</span>
      <span><strong>{sayi('yapimda')}</strong> yapım aşamasında</span>
      <span><strong>{sayi('planlanan')}</strong> planlanan</span>
    </p>
  </Section>

  {(['calisiyor', 'yapimda', 'planlanan'] as Durum[]).map((d, i) => (
    <Section
      num={String(i + 1).padStart(2, '0')}
      kicker={DURUM_ADI[d]}
      title={DURUM_ADI[d]}
      lede={DURUM_ACIKLAMA[d]}
    >
      <ul class="ml-yol" data-durum={d}>
        {maddeler
          .filter((m) => m.durum === d)
          .map((m) => (
            <li>
              <strong>{m.ad}</strong>
              <span>{m.not}</span>
            </li>
          ))}
      </ul>
    </Section>
  ))}

  <Section
    num="04"
    kicker="Kanıt"
    title="“Çalışıyor” ne demek"
    lede="Bir satırın “çalışıyor” sütununda durması için görüş değil kanıt gerekiyor. Sade katman kuralı söyler; teknik katman kanıtı gösterir."
  >
    <Layer kind="simple">
      <p>
        Bir özellik ancak kodda varsa ve çalıştığı doğrulandıysa “çalışıyor” sayılıyor.
        Teknik ayrıntı düğmesi bu doğrulamanın neye dayandığını — testleri, sabitleri ve
        derleme çıktısını — açar.
      </p>
    </Layer>

    <Layer kind="technical" title="Doğrulamanın dayanağı" wide>
      <p>
        Rust tarafında 39 test var: <code>main.rs</code> 10, <code>profile.rs</code> 10,
        <code>auth.rs</code> 5, <code>agents.rs</code> 4, <code>db.rs</code> 4,
        <code>orchestrator.rs</code> 4, <code>audit.rs</code> 2.
        “Çalışıyor” listesindeki dil onarımı ve yedek özet maddelerinin arkasında bu
        testlerin bir kısmı duruyor; ekran görüntüsü değil, çalışan bir kontrol.
      </p>
      <ul>
        <li>
          <strong>Ajan hata yalıtımı:</strong> <code>orchestrator.rs</code> içinde her ajan
          kendi <code>fallback(...)</code> değerine düşüyor — bir ajan çökünce rapor yine
          altı bölümle çıkıyor.
        </li>
        <li>
          <strong>Yedek özet:</strong> sentezöre ulaşılamazsa <code>fallback_summary(...)</code>
          devreye giriyor. Bilinen sınır: kullanıcı raporun yedek yoldan geldiğini
          göremiyor — “planlanan” listesinde bu yüzden bir madde var.
        </li>
        <li>
          <strong>Dil onarımı:</strong> <code>translate_texts(...)</code> yanlış dilde dönen
          alanları yeniden çeviriyor; model Türkçe istenirken İngilizce cevap verdiğinde
          rapor yine Türkçe çıkıyor.
        </li>
        <li>
          <strong>Uzaktan erişimin neden “planlanan” olduğu:</strong> sunucu
          <code>127.0.0.1:3000</code> dinliyor ve uzantıda adres sabit yazılı. Açılması için
          önce HTTPS ve gerçek bir CORS kısıtı gerekiyor — bugün <code>host_permissions</code>
          <code>http://*/*</code> ve <code>https://*/*</code> kadar geniş.
        </li>
      </ul>
    </Layer>
  </Section>

  <Section
    num="05"
    kicker="Yayın durumu"
    title="Kod ve canlı sürüm aynı çizgide"
    lede="Kod, rehber ve üretim yayını aynı doğrulanmış statik çıktıyı kullanıyor."
  >
    <p class="ml-prose">
      Güncel kod, rehber ve dokümantasyon artık <code>GuncelArayuz_Local</code> dalında tek
      ağaçta duruyor. Doğrulanmış yerel derleme 26 sayfayı üretiyor; aynı statik çıktı
      Netlify üretim ortamına aktarılıyor. Yayından sonra ana rotalar, mobil navigasyon,
      arama penceresi ve depo haritası canlı adres üzerinden yeniden denetleniyor.
    </p>
  </Section>
</Base>

<style>
  .ml-ozet {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1rem;
    max-width: none;
    font-family: var(--ml-font-mono);
    font-size: var(--ml-step--1);
    color: var(--ml-ink-muted);
  }
  .ml-ozet strong { color: var(--ml-ink); font-size: var(--ml-step-1); }

  .ml-yol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .ml-yol li {
    display: grid;
    gap: 0.2rem;
    padding: 0.7rem 0.9rem;
    background: var(--ml-paper-warm);
    border-radius: var(--ml-radius);
    border-left: 5px solid var(--ml-line-soft);
  }
  .ml-yol[data-durum='calisiyor'] li { border-left-color: var(--ml-ok); }
  .ml-yol[data-durum='yapimda'] li { border-left-color: var(--ml-warn); }
  .ml-yol[data-durum='planlanan'] li { border-left-color: var(--ml-line-soft); opacity: 0.85; }
  .ml-yol strong { font-family: var(--ml-font-display); font-size: var(--ml-step-0); }
  .ml-yol span { font-size: var(--ml-step--1); color: var(--ml-ink-muted); }
</style>
