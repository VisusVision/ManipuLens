# Trello pano cekimi. Gercek degerleri BU DOSYAYA YAZMA.
# Yerelde: bu dosyayi .env olarak kopyala, degerleri oraya koy (.env git'e girmez).
# CI'da: GitHub repo > Settings > Secrets and variables > Actions altina ekle.
#
# Anahtar: https://trello.com/power-ups/admin  (yeni Power-Up > API key)
# Token:   anahtar sayfasindaki "Token" baglantisi. Yetki OKUMA yeterli.

TRELLO_BOARD=5KCEsJ51
TRELLO_KEY=
TRELLO_TOKEN=
# beyaz = yalniz `site` etiketli kartlar cikar (onerilen)
# kara  = `gizli` etiketliler haric hepsi cikar
# hepsi = filtre yok
TRELLO_FILTRE=beyaz
